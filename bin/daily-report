#!/bin/zsh
# The day's review report: what happened on every PR Sidak reviewed or self-checked that day, and on my own PRs Auto worked on (who
# pushed, replied, reviewed, resolved, merged), gathered from GitHub into reports/<day>.json, then written up by Claude as one private
# Artifact, a new one each run (report-url holds the newest link, report-links.json each day's: Sidak's This week calendar).
#   daily-report [<YYYY-MM-DD>]      pr-board report starts it in a background cmux tab, weekdays from settings.json reportHour (18)
#   PROFILE=cwc ... / MODEL=opus ...
# Interactive Claude in its own tab: a headless claude -p has no Artifact tool (neither profile's had). PROFILE defaults to cc, the
# account whose sessions publish Artifacts.
set -u
# The whole script in one block, read before any of it runs (as claude-fix).
{
SIDAK_DIR=${SIDAK_DIR:-${0:A:h:h}}
STATE=${SIDAK_STATE:-$SIDAK_DIR/state.json}
cfg() { jq -r "$@" $SIDAK_DIR/config.json; }
PROFILE=${PROFILE:-cc}
profile_dir=$(cfg --arg p $PROFILE '.profiles[$p] // ""')
[[ -n $profile_dir ]] && export CLAUDE_CONFIG_DIR=${profile_dir/#\~/$HOME}
day=${1:-$(date +%F)}
out=${STATE:h}/reports
url_file=${STATE:h}/report-url
mkdir -p $out
echo "== daily report $day (PROFILE=$PROFILE MODEL=${MODEL:-sonnet}) =="
python3 - $STATE $SIDAK_DIR/config.json $day $out/$day.json <<'PY' || { echo "could not gather the day"; exec zsh; }
import datetime, json, os, re, subprocess, sys
state_path, config_path, day, out = sys.argv[1:]
state, config = json.load(open(state_path)), json.load(open(config_path))
log_path = os.path.join(os.path.dirname(state_path), "autolog.json")
log = json.load(open(log_path)) if os.path.exists(log_path) else []
start = datetime.datetime.fromisoformat(day).timestamp()  # local midnight
end = start + 86400
def today(ms): return start * 1000 <= (ms or 0) < end * 1000
def iso(text): return datetime.datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp()
def on_day(text): return bool(text) and start <= iso(text) < end
def hm(text): return datetime.datetime.fromtimestamp(iso(text)).strftime("%H:%M")
def hm_ms(ms): return datetime.datetime.fromtimestamp(ms / 1000).strftime("%H:%M")
def short(path): return "/".join(path.split("/")[-2:])  # a file's folder and name: enough to say which file
def cut(text, n): text = re.sub(r"\s+", " ", text or "").strip(); return text if len(text) <= n else text[:n] + "…"
# The day's PRs: a review run of Sidak's that day (claude-review's history), or something Auto did on it (autolog.json).
runs = {}
for key, entry in state.items():
    for run in entry.get("history") or ([entry] if entry.get("state") == "reviewed" else []):
        if today(run.get("at")): runs.setdefault(key, []).append(run)
acts = {}
for e in log:
    if today(e["at"]): acts.setdefault(e["pr"], []).append(e)
keys = sorted(set(runs) | set(acts))
FIELDS = """number title url author { login } state isDraft merged mergedAt mergedBy { login } reviewDecision additions deletions baseRefName body
  files(first: 40) { nodes { path additions deletions } }
  commits(last: 40) { nodes { commit { abbreviatedOid messageHeadline committedDate author { user { login } name } statusCheckRollup { state } } } }
  reviews(last: 40) { nodes { author { login } state submittedAt body } }
  reviewThreads(first: 80) { nodes { isResolved resolvedBy { login } path line comments(last: 15) { nodes { author { login } body createdAt } } } }
  comments(last: 40) { nodes { author { login } body createdAt } }
  timelineItems(last: 60, itemTypes: [MERGED_EVENT, CLOSED_EVENT, REOPENED_EVENT, READY_FOR_REVIEW_EVENT, CONVERT_TO_DRAFT_EVENT,
    REVIEW_REQUESTED_EVENT, HEAD_REF_FORCE_PUSHED_EVENT, REVIEW_DISMISSED_EVENT]) { nodes { __typename
    ... on MergedEvent { createdAt actor { login } } ... on ClosedEvent { createdAt actor { login } } ... on ReopenedEvent { createdAt actor { login } }
    ... on ReadyForReviewEvent { createdAt actor { login } } ... on ConvertToDraftEvent { createdAt actor { login } }
    ... on ReviewRequestedEvent { createdAt actor { login } requestedReviewer { ... on User { login } ... on Team { name } } }
    ... on HeadRefForcePushedEvent { createdAt actor { login } } ... on ReviewDismissedEvent { createdAt actor { login } } } }"""
prs = {}
for i in range(0, len(keys), 8):  # 8 a query keeps each response well under GitHub's limits
    batch = keys[i:i + 8]
    parts = []
    for j, key in enumerate(batch):
        nwo, n = key.split("#"); owner, name = nwo.split("/")
        parts.append(f'p{j}: repository(owner: "{owner}", name: "{name}") {{ pullRequest(number: {n}) {{ {FIELDS} }} }}')
    res = subprocess.run(["gh", "api", "graphql", "-f", "query={ " + " ".join(parts) + " }"], capture_output=True, text=True)
    data = json.loads(res.stdout or "{}").get("data") or {}
    for j, key in enumerate(batch):
        pr = (data.get(f"p{j}") or {}).get("pullRequest")
        if pr: prs[key] = pr
# What the PR is, from its review's "## Overview" (claude-review writes one into the handoff or fix list while it has the whole PR in
# context): the text before its Mermaid block, and the block.
def overview(name, n, entry):
    for path in (entry.get("report"), os.path.join(os.path.dirname(state_path), "handoffs", f"{name}-{n}.md")):
        if not path or not os.path.exists(path): continue
        m = re.search(r"^## Overview[^\n]*\n(.*?)(?=^#|\Z)", open(path).read(), re.M | re.S)
        if not m: continue
        body, d = m.group(1), re.search(r"```mermaid\n(.*?)```", m.group(1), re.S)
        return cut(body[:d.start()] if d else body.split("\n\n")[0], 900), d.group(1).strip() if d else None
    return None, None
me = config["login"]
who = lambda node: ((node or {}).get("login")) or "someone"
result = []
for key in keys:
    pr = prs.get(key)
    if not pr: continue
    entry = state.get(key, {})
    report = entry.get("report") or ""
    about, diagram = overview(key.split("/")[1].split("#")[0], pr["number"], entry)
    fixes = [cut(re.sub(r"\*\*", "", line), 160) for line in open(report).read().splitlines() if re.match(r"^\d+\. \*\*", line)][:10] if report and os.path.exists(report) else []
    head = pr["commits"]["nodes"][-1]["commit"] if pr["commits"]["nodes"] else {}
    happened = []
    for node in pr["commits"]["nodes"]:
        c = node["commit"]
        if on_day(c["committedDate"]):
            happened.append({"at": hm(c["committedDate"]), "who": (c["author"].get("user") or {}).get("login") or c["author"].get("name"), "did": "pushed commit", "what": cut(c["messageHeadline"], 90)})
    for r in pr["reviews"]["nodes"]:
        if on_day(r["submittedAt"]):
            happened.append({"at": hm(r["submittedAt"]), "who": who(r["author"]), "did": {"APPROVED": "approved", "CHANGES_REQUESTED": "requested changes", "COMMENTED": "reviewed with comments", "DISMISSED": "review dismissed"}.get(r["state"], r["state"].lower()), "what": cut(r["body"], 400)})
    open_threads = []
    for t in pr["reviewThreads"]["nodes"]:
        comments = t["comments"]["nodes"]
        for c in comments:
            if on_day(c["createdAt"]):
                happened.append({"at": hm(c["createdAt"]), "who": who(c["author"]), "did": "commented on a thread" if c is not comments[0] else "opened a thread", "where": f'{short(t["path"])}{":" + str(t["line"]) if t.get("line") else ""}', "what": cut(c["body"], 280)})
        if not t["isResolved"] and comments:
            open_threads.append({"where": f'{short(t["path"])}{":" + str(t["line"]) if t.get("line") else ""}', "last_by": who(comments[-1]["author"]), "last": cut(comments[-1]["body"], 160), "opened_by": who(comments[0]["author"])})
        elif t["isResolved"] and t.get("resolvedBy") and any(on_day(c["createdAt"]) for c in comments):
            happened.append({"at": "", "who": who(t["resolvedBy"]), "did": "resolved a thread", "where": short(t["path"])})
    for c in pr["comments"]["nodes"]:
        if on_day(c["createdAt"]):
            happened.append({"at": hm(c["createdAt"]), "who": who(c["author"]), "did": "commented on the PR", "what": cut(c["body"], 280)})
    for ev in pr["timelineItems"]["nodes"]:
        if on_day(ev.get("createdAt")):
            what = ev["__typename"].removesuffix("Event")
            reviewer = ev.get("requestedReviewer") or {}
            happened.append({"at": hm(ev["createdAt"]), "who": who(ev.get("actor")), "did": re.sub(r"(?<!^)([A-Z])", r" \1", what).lower(), **({"what": reviewer.get("login") or reviewer.get("name")} if reviewer else {})})
    happened.sort(key=lambda h: h["at"] or "99")
    # A run of commits by one person is one event: "pushed 13 commits: a; b; …".
    merged = []
    for h in happened:
        prev = merged[-1] if merged else None
        if prev and h["did"] == "pushed commit" and prev["did"] in ("pushed commit", "pushed commits") and prev["who"] == h["who"]:
            if "subjects" not in prev: prev["subjects"] = [prev.pop("what")]
            prev["did"] = "pushed commits"; prev["subjects"].append(h["what"]); continue
        merged.append(h)
    for h in merged:
        if "subjects" in h:
            n = len(h["subjects"]); h["what"] = f"{n} commits: " + "; ".join(h.pop("subjects")[:5]) + (f"; +{n - 5} more" if n > 5 else "")
    happened = merged
    result.append({
        "pr": key.split("/", 1)[1], "title": pr["title"], "url": pr["url"], "author": who(pr["author"]), "mine": who(pr["author"]) == me,
        "status": "merged" if pr["merged"] else pr["state"].lower() + (" draft" if pr["isDraft"] else ""),
        "merged_by": who(pr["mergedBy"]) if pr["merged"] else None, "review_decision": pr["reviewDecision"],
        "checks": (head.get("statusCheckRollup") or {}).get("state"), "size": f'+{pr["additions"]} -{pr["deletions"]}', "base": pr["baseRefName"],
        "our_runs": [{"at": hm_ms(r["at"]), "depth": "Deep" if r.get("depth") == "full" else "Skim", "kind": "self-check" if r.get("self") or report else "review",
                      "verdict": r.get("verdict"), "sha": r.get("sha")} for r in sorted(runs.get(key, []), key=lambda r: r["at"])],
        "our_tldr": entry.get("tldr"), "self_check_fixes": fixes,
        "auto_did": [{"at": hm_ms(e["at"]), "what": e["text"], **({"summary": e["summary"]} if e.get("summary") else {}), **({"outcome": e["done"]} if e.get("done") else {})} for e in acts.get(key, [])],
        "overview": about, "diagram": diagram,
        # No Overview from a review yet: what the PR says about itself, and what it touches.
        **({} if about else {"pr_body": cut(re.sub(r"<!--.*?-->", "", pr["body"] or "", flags=re.S), 600),
                            "files": [f'{f["path"]} +{f["additions"]} -{f["deletions"]}' for f in pr["files"]["nodes"]][:12]}),
        "happened_today": happened, "open_threads": open_threads,
    })
json.dump({"day": day, "me": me, "prs": result}, open(out, "w"), separators=(",", ":"))
# The page's facts (report/index.html draws them; Claude writes only the words): what GitHub and Sidak's state say, nothing written.
runs_all = [r for p in result for r in p["our_runs"]]
reviews = [r for r in runs_all if r["kind"] == "review"]
facts = {"day": day, "me": me, "made": datetime.datetime.now().strftime("%H:%M"),
         "counts": {"prs": len(result), "mine": sum(p["mine"] for p in result), "reviews": len(reviews),
                    **{v: sum(r["verdict"] == v for r in reviews) for v in ("approved", "changes", "commented")},
                    "self_checks": len(runs_all) - len(reviews), "fixes": sum(e.get("kind") == "fix" for k in keys for e in acts.get(k, [])),
                    "merged": sum(p["status"] == "merged" for p in result), "closed": sum(p["status"] == "closed" for p in result)},
         "prs": []}
for p in result:
    pr = prs["/".join([p["url"].split("/")[3], p["pr"]])]
    facts["prs"].append({"key": p["pr"], "repo": p["pr"].split("#")[0], "n": pr["number"], "url": p["url"], "title": p["title"], "author": p["author"],
                         "mine": p["mine"], "status": "merged" if pr["merged"] else pr["state"].lower(), "draft": pr["isDraft"],
                         "decision": pr["reviewDecision"], "checks": p["checks"], "add": pr["additions"], "del": pr["deletions"], "base": p["base"],
                         "merged_by": p["merged_by"], "merged_at": hm(pr["mergedAt"]) if pr["merged"] and pr.get("mergedAt") else None,
                         "diagram": p["diagram"], "runs": [{k: r[k] for k in ("at", "depth", "kind", "verdict")} for r in p["our_runs"]]})
page = os.path.splitext(out)[0]
os.makedirs(page, exist_ok=True)
json.dump(facts, open(os.path.join(page, "facts.json"), "w"), indent=1)
print(f"{len(result)} PRs, {sum(len(p['happened_today']) for p in result)} things people did")
PY
prompt=$(cat <<EOF
Write the words for my daily review report for $day, then publish it. The page is designed already: $day/index.html draws everything from $day/facts.json and the $day/words.json you write. Do not load design skills, do not run a quickstart, and do not change index.html or facts.json.

The day's data is in $day.json: every PR Sidak reviewed or self-checked that day and my own PRs Auto worked on. Per PR: overview (what the PR is, from Sidak's reviewer) or, when there is none, pr_body and files; what each person did on GitHub that day (happened_today, oldest first); the threads still open; Sidak's own runs (our_runs, our_tldr, self_check_fixes); Auto's actions (auto_did, with fix summaries). I am $(cfg .login), "you" in the words; Sidak and Auto post as me. Read it with a script rather than whole. Use only the data; never guess.

Write $day/words.json in exactly this shape; the keys of prs are each PR's "pr" value, and every PR in the data gets one:
{"overview": ["three short sentences on the day"],
 "needs_me": [{"pr": "crm#1", "why": "what I must do, 12 words at most"}],
 "waiting": [{"pr": "crm#2", "why": "who, and for what, 12 words at most"}],
 "prs": {"crm#1": {
   "title": "the PR's subject in 6 words at most",
   "next": {"who": "me, others or none", "text": "the one next step and whose it is, 15 words at most"},
   "what": "what the PR changes and why, two to four short sentences, from its overview or else pr_body and files",
   "diagram": "only when the PR's diagram is null and pr_body and files show the pieces clearly: a Mermaid flowchart TD, at most 8 nodes, short double-quoted labels, no semicolons",
   "found": ["at most three findings of our review, one line each; on my own PRs, the Blocking and Should fix items"],
   "today": [["18:08", "Jasonnn-cc", "pushed 13 commits: ticket panel translations, label refresh"]],
   "open": [["displayValue.ts:44", "the question in a few words", "who must answer"]]}}}
Plain words, one fact per line, no shas, quotes of 15 words at most. today: one row per event, oldest first, 15 words at most each; join one person's events in a row; Auto's fixes with their summary. A merged PR, or one that needs nothing more, has next.who "none".

Then publish $day/index.html with the Artifact tool as a new artifact (no url; do not read or update an earlier report), with files {"facts.json": "$day/facts.json", "words.json": "$day/words.json"}, icon "calendar" and a one-line description. Then write its link to $url_file, replacing what is there, alone on one line, as the very last step: its time tells Sidak the report is out. Then stop; no summary in the terminal.
EOF
)
# Each day's link into report-links.json (the board's calendar) once Claude writes report-url; the tab closing does not stop it, and
# it gives up after two hours.
started=$(mktemp)
( trap '' HUP TERM
  for i in {1..1440}; do [[ $url_file -nt $started ]] && break; sleep 5; done
  [[ $url_file -nt $started ]] && python3 -c 'import json, os, sys
path, day, url = sys.argv[1:]
links = json.load(open(path)) if os.path.exists(path) else {}
links[day] = url
json.dump(links, open(path + ".tmp", "w"), indent=1, sort_keys=True); os.replace(path + ".tmp", path)' ${STATE:h}/report-links.json $day "$(head -1 $url_file)"
  rm -f $started ) &!
# The page: report/index.html, titled with the day, beside facts.json.
sed "s|<title>Sidak daily report</title>|<title>Sidak report $(date -j -f %F $day '+%a %-d %b')</title>|" $SIDAK_DIR/report/index.html > $out/$day/index.html
cd $out
claude --dangerously-skip-permissions --model ${MODEL:-sonnet} --effort ${EFFORT:-high} "$prompt"
echo; echo "daily report $day finished (exit $?)"
exec zsh
}; exit
