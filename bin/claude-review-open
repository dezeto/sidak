#!/bin/zsh
# Focus the cmux workspace reviewing a PR, or start one.
# Takes ccreview://<owner>/<repo>/<pr>[/<model>[/<effort>[/<depth>]]], ccreview://<pr>[...] (the first reviewable repo in config.json), or a bare number.
# Also ccfix://<owner>/<repo>/<pr>/<model>/<effort> (claude-fix on my own PR's branch) and ccmerge://<owner>/<repo>/<pr> (squash-merge),
# ccnudge://<owner>/<repo>/<pr> (re-request every pending reviewer), ccready://<owner>/<repo>/<pr> (leave draft),
# ccapprove://<owner>/<repo>/<pr> (approve as me), ccask://<owner>/<repo>/<pr>/<url-encoded question> (claude-ask),
# ccopen://<owner>/<repo>/<pr> (Zed on the review worktree, else the checkout) and ccset://<url-encoded JSON> (the panel's settings.json, replaced atomically).
# A new review runs on the Claude profile in settings.json (claude-review PROFILE) when config.json has it, else defaultProfile.
# FOCUS=false starts the review workspace without switching to it; AUTO=1 (pr-board auto) marks the run "auto" in state.json.
url=${1:?pr}; scheme=${url%%://*}; url=${url#*://}; url=${url%/}
# Arc's native host and Sidak.app start this with launchd's PATH, which has no Homebrew gh.
path+=(/opt/homebrew/bin /usr/local/bin)
SIDAK_DIR=${SIDAK_DIR:-${0:A:h:h}}
cfg() { jq -r "$@" $SIDAK_DIR/config.json; }
org=$(cfg .org) repos=$(cfg .repos); repos=${repos/#\~/$HOME}
if [[ $scheme == ccset ]]; then
  exec python3 -c 'import json, os, sys, urllib.parse; text = json.dumps(json.loads(urllib.parse.unquote(sys.argv[1])), indent=2) + "\n"; out = sys.argv[2]; open(out + ".tmp", "w").write(text); os.replace(out + ".tmp", out)' \
    "$url" $SIDAK_DIR/settings.json
fi
parts=(${(s:/:)url})
if [[ $parts[1] == <-> ]]; then repo=$(cfg '.reviewable[0]'); n=$parts[1]; model=$parts[2]; effort=$parts[3]; depth=$parts[4]
else repo=$parts[2]; n=$parts[3]; model=$parts[4]; effort=$parts[5]; depth=$parts[6]; fi
cmux=/Applications/cmux.app/Contents/Resources/bin/cmux
if [[ $scheme == ccmerge ]]; then
  out=$(gh pr merge "$n" -R "$org/$repo" --squash --delete-branch 2>&1) && exit 0
  # A PR in a stack merges only through the asynchronous endpoint: GitHub accepts it (pending) and merges in the background.
  [[ $out == *"part of a stack"* ]] || { print -r -- "$out" >&2; exit 1; }
  exec gh api -X PUT "repos/$org/$repo/pulls/$n/merge-async" -f merge_method=squash --jq '"merge \(.status)"'
fi
if [[ $scheme == ccnudge ]]; then
  # Asking again someone already asked is a no-op on GitHub (no notification), so each pending request is withdrawn and made again:
  # the new request is what pings them.
  pending=$(gh pr view "$n" -R "$org/$repo" --json reviewRequests --jq '[.reviewRequests[] | .login // (.slug | select(.) | "'$org'/" + .)] | join(",")')
  [[ -n $pending ]] || { print "nobody is pending on $repo#$n" >&2; exit 1; }
  gh pr edit "$n" -R "$org/$repo" --remove-reviewer "$pending" >/dev/null || exit 1
  gh pr edit "$n" -R "$org/$repo" --add-reviewer "$pending" >/dev/null || exit 1
  exec print "nudged ${pending//,/, }"
fi
if [[ $scheme == ccready ]]; then exec gh pr ready "$n" -R "$org/$repo"; fi
# Approve: my approval, posted as me, only ever from a tap (the board asks first).
if [[ $scheme == ccapprove ]]; then gh pr review "$n" -R "$org/$repo" --approve >/dev/null && exec print "approved $repo#$n"; exit 1; fi
# Ask: a question about Claude's review of this PR, answered in a visible cmux tab (claude-ask); the answer lands in state.json.
if [[ $scheme == ccask ]]; then
  q=$(python3 -c 'import sys, urllib.parse; print(urllib.parse.unquote(sys.argv[1]))' "$parts[4]")
  [[ -n $q ]] || { print "no question" >&2; exit 1; }
  profile=$(jq -r '.profile // ""' $SIDAK_DIR/settings.json 2>/dev/null)
  [[ $(cfg --arg p "$profile" '.profiles | has($p)') == true ]] || profile=$(cfg .defaultProfile)
  ref=$(CMUX_QUIET=1 $cmux workspace list 2>/dev/null | grep -E "ask $repo#$n( |$)" | grep -oE 'workspace:[0-9]+' | head -1)
  [[ -n $ref ]] && $cmux close-workspace --workspace "$ref" --force >/dev/null 2>&1
  exec $cmux new-workspace --focus ${FOCUS:-false} --name "ask $repo#$n" --cwd "$repos/$repo" \
    --command "PROFILE=$profile ${(q)SIDAK_DIR}/bin/claude-ask $repo $n ${(q)q}"
fi
if [[ $scheme == ccopen ]]; then
  dir=$repos/$repo
  [[ -d $dir/.claude/worktrees/review-$n ]] && dir+=/.claude/worktrees/review-$n
  exec ${commands[zed]:-/usr/local/bin/zed} "$dir"
fi
if [[ $scheme == ccfix ]]; then
  profile=$(jq -r '.profile // ""' $SIDAK_DIR/settings.json 2>/dev/null)
  [[ $(cfg --arg p "$profile" '.profiles | has($p)') == true ]] || profile=$(cfg .defaultProfile)
  ref=$(CMUX_QUIET=1 $cmux workspace list 2>/dev/null | grep -E "fix $repo#$n( |$)" | grep -oE 'workspace:[0-9]+' | head -1)
  # Its fix tab with Claude still open (claude-fix settles on Claude's summary and leaves the session to me): the ask goes to it, as
  # to the author's session below. A board Fix never lands here while that fix runs: the board hides Fix then.
  if [[ -n $ref ]] && pgrep -f "bin/claude-fix $repo $n\$" >/dev/null; then
    sid="" surface=$ref wsref=$ref title="fix $repo#$n"
  else
    # Its Claude gone, the tab is an idle shell: from Auto (FOCUS=false) closed, and a fresh one starts; from the board, shown.
    if [[ -n $ref && ${FOCUS:-true} == false ]]; then $cmux close-workspace --workspace "$ref" --force >/dev/null 2>&1; ref=""; fi
    if [[ -n $ref ]]; then exec $cmux workspace select "$ref"; fi
    # The session that opened the PR fixes it, with what it already knows (bin/author-session). Running in a tab: the ask is queued
    # there (cmux agent message goes through Claude's hooks, never typed; a busy session reads it at its next step) and the card says
    # Fix sent. Closed: claude-fix resumes it (RESUME) on its own profile. No linked session: a fresh claude-fix.
    IFS=$'\t' read sid sprofile surface wsref title <<< "$($SIDAK_DIR/bin/author-session $org/$repo $n)"
  fi
  if [[ -n $surface ]]; then
    # Sent from no tab: Sidak.app launched from a cmux tab inherits its CMUX_* ids, and the session's replies would land in that tab.
    env -u CMUX_SURFACE_ID -u CMUX_PANEL_ID -u CMUX_TAB_ID -u CMUX_WORKSPACE_ID $cmux agent message "$surface" --from Sidak -- "Sidak: my PR #$n ($org/$repo) needs fixing. If $SIDAK_DIR/reviews/$repo-$n.md exists, it is my self-check's fix list for it: apply each fix that still applies, the blocking ones first. Then every unresolved review thread or change request, failing checks (gh pr checks $n) and conflicts with the base. Stay inside the PR's scope, commit in small signed commits, push, reply on each thread you addressed with one line and the sha, and re-request review from whoever asked for changes." >/dev/null || exit 1
    # Onto the PR's state.json entry (its self-check), which the next self-check replaces. No entry: none made, as one would count as a run.
    python3 -c 'import json, sys, time; p, k, t = sys.argv[1:]; d = json.load(open(p))
if k in d: d[k].update(sent=t, sentAt=int(time.time() * 1000)); json.dump(d, open(p, "w"))' $SIDAK_DIR/state.json "$org/$repo#$n" "$title"
    [[ ${FOCUS:-true} == true ]] && $cmux workspace select "$wsref"
    exit 0
  fi
  exec $cmux new-workspace --focus ${FOCUS:-true} --name "fix $repo#$n" --cwd "$repos/$repo" \
    --command "PROFILE=${sprofile:-$profile} ${sid:+RESUME=$sid }${model:+MODEL=$model }${effort:+EFFORT=$effort }${(q)SIDAK_DIR}/bin/claude-fix $repo $n"
fi
# Focus only while state.json says the review is still running; a finished run's idle workspace is closed and a fresh one starts (re-review).
ref=$(CMUX_QUIET=1 $cmux workspace list 2>/dev/null | grep -E "review $repo#$n( |$)" | grep -oE 'workspace:[0-9]+' | head -1)
state=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2], {}).get("state", ""))' $SIDAK_DIR/state.json "$org/$repo#$n" 2>/dev/null)
if [[ -n $ref && $state != running ]]; then $cmux close-workspace --workspace "$ref" --force >/dev/null 2>&1; ref=""; fi
if [[ -n $ref ]]; then
  $cmux workspace select "$ref"
else
  profile=$(jq -r '.profile // ""' $SIDAK_DIR/settings.json 2>/dev/null)
  [[ $(cfg --arg p "$profile" '.profiles | has($p)') == true ]] || profile=$(cfg .defaultProfile)
  $cmux new-workspace --focus ${FOCUS:-true} --name "review $repo#$n" --cwd "$repos/$repo" \
    --command "PROFILE=$profile ${AUTO:+AUTO=1 }${model:+MODEL=$model }${effort:+EFFORT=$effort }${depth:+DEPTH=$depth }${(q)SIDAK_DIR}/bin/claude-review $repo $n"
fi
