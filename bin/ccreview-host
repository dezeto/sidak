#!/usr/bin/env python3
# Native-messaging host for the PR dashboard: {"url": "ccreview://..."} -> ~/bin/claude-review-open.
import json, os, struct, subprocess, sys
open("/Users/adrian/.ccreview-host.log", "a").write(f"{__import__('time').ctime()} start argv={sys.argv[1:]}\n")
raw = sys.stdin.buffer.read(4)
msg = json.loads(sys.stdin.buffer.read(struct.unpack("<I", raw)[0])) if len(raw) == 4 else {}
try:
    env = dict(os.environ, CMUX_QUIET="1", CMUX_SOCKET_PASSWORD=open(os.path.expanduser("~/.config/cmux/socket-password")).read().strip())
    subprocess.run(["/Users/adrian/bin/claude-review-open", msg["url"]], check=True, capture_output=True, text=True, timeout=20, env=env)
    # Settings, nudges, mark-ready and Zed run in place: bringing cmux forward would close the Arc popup.
    if not msg["url"].startswith(("ccset:", "ccnudge:", "ccready:", "ccopen:")):
        subprocess.run(["osascript", "-e", 'tell application "cmux" to activate'], capture_output=True, timeout=10)
    out = {"ok": True}
except Exception as e:  # ponytail: one error string back to the panel, no codes
    out = {"ok": False, "error": getattr(e, "stderr", None) or str(e)}
open("/Users/adrian/.ccreview-host.log", "a").write(f"  msg={msg} out={out}\n")
body = json.dumps(out).encode()
sys.stdout.buffer.write(struct.pack("<I", len(body)) + body); sys.stdout.buffer.flush()
