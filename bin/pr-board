#!/bin/zsh
# The PR review board for the phone: the same reviews as the Arc panel, driven from a Remote Control session.
#   pr-board board                          To review / Running / Reviewed
#   pr-board auto                           one auto-review tick (Sidak.app runs it on the panel's refresh interval (settings.json pollMinutes, default 2 min)); DRY=1 prints the URL only
#   pr-board quick|review [<repo>] <pr>     start a review in cmux (repo defaults to the first reviewable one)
#   pr-board status [<repo>] <pr>           run state + my latest review on the PR
#   pr-board wait [<repo>] <pr>             block until the running review settles, then status
#   pr-board approve [<repo>] <pr> [note]   approve the PR head
#   pr-board phone                          start the Remote Control session on the personal account (the phone's)
#   MODEL=sonnet EFFORT=high ...            review overrides; default opus, medium for quick and high for review
set -u
# SIDAK_STATE / SIDAK_SETTINGS point at copies for a dry run.
SIDAK_DIR=${SIDAK_DIR:-${0:A:h:h}}
cfg() { jq -r "$@" $SIDAK_DIR/config.json; }
STATE=${SIDAK_STATE:-$SIDAK_DIR/state.json}
SETTINGS=${SIDAK_SETTINGS:-$SIDAK_DIR/settings.json}
ORG=$(cfg .org) ME=$(cfg .login) FIRST=$(cfg '.reviewable[0]')
cmd=${1:-board}; shift 2>/dev/null
if [[ ${1:-} == <-> ]]; then repo=$FIRST; else repo=${1:-$FIRST}; shift 2>/dev/null; fi
n=${1:-}; note=${2:-}
key=$ORG/$repo#$n
entry() { jq -r --arg k "$key" ".[\$k].$1 // \"\"" $STATE; }

# Reviewed PRs that moved since my review (pr.js followUp) as a JSON array, each with movedAt in ms: my latest request after the
# review, else the last commit when the head moved past the reviewed sha (no sha: a commit dated after the review) and the review
# was not an approval. [] when GitHub does not answer.
updated() {
  python3 - $STATE <<'PY'
import datetime, json, subprocess, sys
state = json.load(open(sys.argv[1]))
QUERY = """query ($q: String!) { viewer { login } search(query: $q, type: ISSUE, first: 50) { nodes { ... on PullRequest {
  number title isDraft updatedAt headRefOid repository { name nameWithOwner } author { login } commits(last: 1) { nodes { commit { committedDate } } }
  timelineItems(itemTypes: [REVIEW_REQUESTED_EVENT], last: 10) { nodes { ... on ReviewRequestedEvent { createdAt requestedReviewer { ... on User { login } } } } } } } } }"""
out = subprocess.run(["gh", "api", "graphql", "-f", f"query={QUERY}", "-f", "q=is:open is:pr archived:false reviewed-by:@me -author:@me sort:created-asc"],
                     capture_output=True, text=True)
if out.returncode: sys.exit(print("[]"))
found = json.loads(out.stdout)["data"]
def ms(iso): return datetime.datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp() * 1000
def moved_at(pr):
    entry = state.get(f'{pr["repository"]["nameWithOwner"]}#{pr["number"]}', {})
    if entry.get("state") != "reviewed": return None
    asked = [e["createdAt"] for e in pr["timelineItems"]["nodes"] if (e.get("requestedReviewer") or {}).get("login") == found["viewer"]["login"]]
    if asked and ms(asked[-1]) > entry["at"]: return ms(asked[-1]), True
    pushed = ms(pr["commits"]["nodes"][0]["commit"]["committedDate"]) if pr["commits"]["nodes"] else 0
    moved = pr["headRefOid"] != entry["sha"] if entry.get("sha") else pushed > entry["at"]
    return (pushed, False) if moved and entry.get("verdict") != "approved" else None
print(json.dumps([{**pr, "movedAt": at[0], "asked": at[1]} for pr in found["search"]["nodes"] if (at := moved_at(pr)) is not None]))
PY
}

# Reviews that ended without cleaning up after themselves (the tab closed before the trap ran, or the script died): a claude-review
# or claude-fix whose process is gone leaves its worktree and a "running" entry. Removes such a worktree, settles the entry (reviewed
# when its handoff or fix list was written during the run, else failed) and stops a watcher left behind (reparented to launchd).
sweep() {
  python3 - $STATE $SIDAK_DIR "$(cfg .repos)" <<'PY'
import glob, json, os, re, signal, subprocess, sys, time
state_path, sidak, repos = sys.argv[1], sys.argv[2], os.path.expanduser(sys.argv[3])
alive = set()
for line in subprocess.run(["ps", "-axo", "pid=,ppid=,command="], capture_output=True, text=True).stdout.splitlines():
    pid, ppid, command = line.split(None, 2)
    run = re.search(r"bin/claude-(?:review|fix) (\S+) (\d+)$", command)
    if not run: continue
    if ppid == "1": os.kill(int(pid), signal.SIGKILL)
    else: alive.add((run[1], run[2]))
for wt in glob.glob(f"{repos}/*/.claude/worktrees/review-*"):
    repo, n = wt.split("/")[-4], wt.rsplit("-", 1)[1]
    if (repo, n) in alive: continue
    checkout = wt.rsplit("/.claude/", 1)[0]
    if subprocess.run(["git", "-C", checkout, "worktree", "remove", "--force", wt], capture_output=True).returncode:
        subprocess.run(["rm", "-rf", "--", wt])
state = json.load(open(state_path))
changed = False
for key, entry in state.items():
    repo, n = key.split("/", 1)[1].split("#")
    # A minute's grace: a run marks itself running before its process shows up in ps.
    if entry.get("state") != "running" or (repo, n) in alive or time.time() * 1000 - entry["at"] < 60000: continue
    if entry.get("depth") == "fix":
        state[key] = entry.get("prev") or None
        changed = True
        continue
    notes = [f for f in (f"{sidak}/reviews/{repo}-{n}.md", f"{sidak}/handoffs/{repo}-{n}.md") if os.path.exists(f) and os.path.getmtime(f) > entry.get("run", 0)]
    entry.update(state="reviewed" if notes else "failed", at=int(time.time() * 1000))
    if notes and "/reviews/" in notes[0]: entry["report"] = notes[0]
    changed = True
if changed: json.dump({key: entry for key, entry in state.items() if entry}, open(state_path, "w"))
PY
}

# Learning from my hand on Claude's reviews: a comment I deleted is a point not to make, one I reworded shows how to say it. And
# from the author's: a thread they replied to that was resolved with the code unchanged is a point this team does not want.
# Each review Claude posted gets its inline comments saved (learn/posted.json) on the first board after it lands; for a week after,
# at most hourly, they are compared with GitHub and every deletion or edit is appended to learn/lessons.jsonl, which claude-review
# hands to the next review. Runs in the background of board, so the menu bar count never waits on it.
learn() {
  python3 - $STATE $SIDAK_DIR/learn "$ME" <<'PY'
import calendar, json, os, subprocess, sys, time
state_path, folder, me = sys.argv[1:]
os.makedirs(folder, exist_ok=True)
posted_path, lessons_path = f"{folder}/posted.json", f"{folder}/lessons.jsonl"
posted = json.load(open(posted_path)) if os.path.exists(posted_path) else {}
state = json.load(open(state_path))
now = time.time()
def gh(path):
    out = subprocess.run(["gh", "api", f"{path}?per_page=100"], capture_output=True, text=True)
    return json.loads(out.stdout) if out.returncode == 0 else None
# Save each new review's comments as posted. Own PRs' self-checks post nothing; a review older than two days is left alone.
for key, entry in state.items():
    if entry.get("state") != "reviewed" or entry.get("report") or now - entry.get("run", 0) > 2 * 86400: continue
    if posted.get(key, {}).get("run") == entry.get("run"): continue
    repo, n = key.split("#")
    reviews = gh(f"repos/{repo}/pulls/{n}/reviews")
    if reviews is None: continue
    mine = [r for r in reviews if r["user"]["login"] == me and r.get("submitted_at") and
            calendar.timegm(time.strptime(r["submitted_at"], "%Y-%m-%dT%H:%M:%SZ")) >= entry["run"] - 60]
    if not mine: continue
    review = mine[-1]
    comments = gh(f"repos/{repo}/pulls/{n}/reviews/{review['id']}/comments") or []
    posted[key] = {"run": entry["run"], "review": review["id"], "checked": now, "since": now,
                   "comments": [{"id": c["id"], "path": c["path"], "line": c.get("line") or c.get("original_line"), "body": c["body"]} for c in comments]}
# Compare: a comment gone was deleted; one with another body was rewritten; one whose thread the author answered and that was resolved
# while its line stayed as it was (not outdated) was pushed back. A resolved thread whose line changed was taken: it just leaves. Each
# counts once, then leaves the snapshot.
THREADS = """query ($owner: String!, $name: String!, $n: Int!) { repository(owner: $owner, name: $name) { pullRequest(number: $n) {
  author { login } reviewThreads(first: 100) { nodes { isResolved isOutdated comments(first: 30) { nodes { databaseId author { login } body } } } } } } }"""
def threads(repo, n):
    owner, name = repo.split("/")
    out = subprocess.run(["gh", "api", "graphql", "-f", f"query={THREADS}", "-f", f"owner={owner}", "-f", f"name={name}", "-F", f"n={n}"],
                         capture_output=True, text=True)
    if out.returncode: return None, {}
    pr = json.loads(out.stdout)["data"]["repository"]["pullRequest"]
    return (pr["author"] or {}).get("login"), {t["comments"]["nodes"][0]["databaseId"]: t for t in pr["reviewThreads"]["nodes"] if t["comments"]["nodes"]}
lessons = []
for key, snap in list(posted.items()):
    if now - snap["since"] > 7 * 86400: del posted[key]; continue
    if now - snap["checked"] < 3600 or not snap["comments"]: continue
    repo, n = key.split("#")
    current = gh(f"repos/{repo}/pulls/{n}/comments")
    if current is None: continue
    snap["checked"] = now
    by_id = {c["id"]: c["body"] for c in current}
    author, thread_of = threads(repo, n)
    keep = []
    for c in snap["comments"]:
        thread = thread_of.get(c["id"])
        replies = [r["body"] for r in (thread or {}).get("comments", {}).get("nodes", [])[1:] if (r["author"] or {}).get("login") == author]
        if c["id"] not in by_id:
            lessons.append({"at": int(now), "pr": key, "path": c["path"], "kind": "deleted", "before": c["body"]})
        elif by_id[c["id"]].strip() != c["body"].strip():
            lessons.append({"at": int(now), "pr": key, "path": c["path"], "kind": "edited", "before": c["body"], "after": by_id[c["id"]]})
        elif thread and thread["isResolved"] and not thread["isOutdated"] and replies:
            lessons.append({"at": int(now), "pr": key, "path": c["path"], "kind": "pushback", "before": c["body"], "reply": replies[-1]})
        elif not (thread and thread["isResolved"]): keep.append(c)
    snap["comments"] = keep
with open(lessons_path, "a") as f:
    for lesson in lessons: f.write(json.dumps(lesson) + "\n")
tmp = posted_path + ".tmp"; json.dump(posted, open(tmp, "w")); os.replace(tmp, posted_path)
PY
}

board() {
  # Self-check fix lists (claude-review on my own PR) last a week.
  rm -f -- $SIDAK_DIR/reviews/*.md(N.mh+168)
  sweep
  learn >/dev/null 2>&1 &!
  local s=$(<$STATE) moved=$(updated)
  # The panel's stale cut-off (settings.json staleDays, default 30, 0 = off) keeps the menu bar count in step with its Inbox.
  local days=$(python3 -c 'import json, sys; print(int(json.load(open(sys.argv[1])).get("staleDays", 30)))' $SETTINGS 2>/dev/null || print 30)
  # Filtered here, not with --updated, so VIP authors (settings.json vip, logins only) still count when stale, as in the panel.
  local cutoff=$(( days > 0 ? ($(date +%s) - days * 86400) * 1000 : 0 ))
  local vip=$(jq -c '.vip // []' $SETTINGS 2>/dev/null || print '[]')
  # Snoozed PRs (settings.json snooze, h in the panel) stay out of the count until their time.
  local snooze=$(jq -c --argjson now $(( $(date +%s) * 1000 )) '(.snooze // {}) | with_entries(select(.value > $now))' $SETTINGS 2>/dev/null || print '{}')
  print "To review"
  gh search prs --review-requested=@me --state=open --archived=false --json repository,number,title,author,updatedAt --limit 50 |
    jq -r --argjson s "$s" --argjson z "$snooze" --argjson cutoff $cutoff --argjson vip "$vip" '.[] | (.repository.nameWithOwner + "#" + (.number | tostring)) as $k | ($s[$k].state // "") as $st
      | select($st != "running" and $st != "reviewed" and ($z[$k] | not))
      | select((.updatedAt | sub("\\.[0-9]+"; "") | fromdateiso8601 * 1000) > $cutoff or ([.author.login] | inside($vip)))
      | "  \(.repository.name)#\(.number) \(.title) (\(.author.login))\(if $st == "failed" then " [failed]" else "" end)"'
  # Reviewed PRs that moved since my review are to review again, as in the panel's Inbox.
  jq -r --argjson z "$snooze" '.[] | select($z[.repository.nameWithOwner + "#" + (.number | tostring)] | not)
    | "  \(.repository.name)#\(.number) \(.title) (\(.author.login)) [updated]"' <<< $moved
  print "Running"
  jq -r --arg org "$ORG/" 'to_entries[] | select(.value.state == "running") | "  \(.key | ltrimstr($org)) [\(.value.depth // "full")]"' $STATE
  print "Reviewed"
  gh search prs --reviewed-by=@me --state=open --archived=false --json repository,number,title --limit 50 |
    jq -r --argjson s "$s" --argjson m "$moved" '[$m[] | .repository.nameWithOwner + "#" + (.number | tostring)] as $moved
      | .[] | (.repository.nameWithOwner + "#" + (.number | tostring)) as $k | $s[$k] as $e | select($e.state == "reviewed" and ($moved | index($k)) == null)
      | "  \(.repository.name)#\(.number) \(.title) [\($e.depth // "full")]"'
}

# The opener runs outside the Arc host here, so it needs the cmux socket password itself.
start() {
  local before=$(entry at)
  local depth=full effort=${EFFORT:-high}
  [[ $cmd == quick ]] && { depth=quick; effort=${EFFORT:-medium}; }
  CMUX_QUIET=1 CMUX_SOCKET_PASSWORD=$(tr -d '[:space:]' < ~/.config/cmux/socket-password) \
    $SIDAK_DIR/bin/claude-review-open "ccreview://$ORG/$repo/$n/${MODEL:-opus}/$effort/$depth" >/dev/null || { print "could not open cmux"; return 1; }
  # Started once the script has marked a new run; it needs a few seconds to boot.
  repeat 15; do
    [[ $(entry state) == running && $(entry at) != $before ]] && { print "started $repo#$n ($depth, ${MODEL:-opus}/$effort)"; return; }
    sleep 2
  done
  print "the review of $repo#$n did not start; check the cmux workspace"; return 1
}

# While settings.json auto.on, start a quick review of every Inbox PR in cmux workspaces that do not take focus, with the panel's
# model and effort (Deep instead of a quick review for a risky PR: see depth_of): my own ready PRs first (a self-check), then VIPs, then the oldest request; at most settings.json autoCap auto runs a day (0, the default: no limit). A PR with a state.json entry is never started
# again, unless it is a manual run that failed, or a follow-up (updated): one I reviewed whose author pushed or re-requested me since,
# re-reviewed once it has been quiet for an hour (a re-request: a Skim right away). Ahead of all of them, claude-fix on my own PRs that fail checks, conflict or wait on
# me for a change request (see fixes). The one output line starts with "auto on" while the mode is on.
auto() {
  local line=$(UPDATED=$(updated) python3 - $SETTINGS $STATE $SIDAK_DIR/config.json <<'PY'
import datetime, json, os, subprocess, sys, time
settings_path, state_path, config_path = sys.argv[1:]
settings, config = json.load(open(settings_path)), json.load(open(config_path))
if not settings.get("auto", {}).get("on"): sys.exit(print("auto off"))
# Quiet hours (settings.json quiet): night is 22:00-08:00, week adds Saturday and Sunday. What waits starts once they end.
clock = datetime.datetime.now()
quiet = settings.get("quiet", "off")
if quiet in ("night", "week") and (clock.hour >= 22 or clock.hour < 8) or quiet == "week" and clock.weekday() >= 5:
    sys.exit(print("auto on (quiet hours)"))
if subprocess.run(["pgrep", "-x", "cmux"], capture_output=True).returncode: sys.exit(print("auto on (no cmux)"))
state = json.load(open(state_path))
now = time.time()
midnight = datetime.datetime.combine(datetime.date.today(), datetime.time()).timestamp()
cap = int(settings.get("autoCap", 0))
left = cap - sum(e.get("auto", False) and e.get("run", 0) >= midnight for e in state.values()) if cap else None
if left is not None and left <= 0: sys.exit(print("auto on (cap)"))
# The Inbox's rules: reviewable from config.json, stale and VIP like pr.js (a VIP is never stale). VIP by login only: the search has no commit email.
reviewable = config["reviewable"]
vip = {entry.lower() for entry in settings.get("vip", [])}
days = int(settings.get("staleDays", 30))
search = subprocess.run(["gh", "search", "prs", "--review-requested=@me", "--state=open", "--archived=false", "--sort", "created", "--order", "asc",
                         "--limit", "50", "--json", "repository,number,isDraft,author,updatedAt"], capture_output=True, text=True)
if search.returncode: sys.exit(print("auto on (gh failed)"))
def is_vip(pr): return (pr["author"] or {}).get("login", "").lower() in vip
def stale(pr): return days > 0 and not is_vip(pr) and now - datetime.datetime.fromisoformat(pr["updatedAt"].replace("Z", "+00:00")).timestamp() > days * 86400
snooze = settings.get("snooze", {})
def key(pr): return f'{pr["repository"]["nameWithOwner"]}#{pr["number"]}'
# autofix.json: what Auto already did per PR (fixes, reruns, restacks, updates, retries, nudges), so none repeats.
fix_path = os.path.join(os.path.dirname(state_path), "autofix.json")
fixed = json.load(open(fix_path)) if os.path.exists(fix_path) else {}
# A failed run starts again: a manual one on the next tick (I asked for it), an Auto one once per PR after an hour (a cmux hiccup, a
# rate limit), kept in autofix.json "<key> retry". Failing again, it is left to me.
def done(pr):
    entry = state.get(key(pr))
    if entry is None or entry.get("state") != "failed": return entry is not None
    return bool(entry.get("auto")) and (key(pr) + " retry" in fixed or now * 1000 - entry.get("at", 0) < 3600 * 1000)
# claude-review without a checkout exits before marking, so such a PR would reopen every tick.
def checked_out(repo): return os.path.isdir(os.path.join(os.path.expanduser(config["repos"]), repo, ".git"))
# Snoozed in the panel (h): not today.
def eligible(pr): return (pr["repository"]["nameWithOwner"].startswith(config["org"] + "/") and pr["repository"]["name"] in reviewable
                          and not pr["isDraft"] and not stale(pr) and snooze.get(key(pr), 0) <= now * 1000 and checked_out(pr["repository"]["name"]))
todo = [pr for pr in json.loads(search.stdout) if eligible(pr) and not done(pr)]
# My own PRs once they are ready (out of draft): a self-check each (claude-review writes a fix list, posts nothing), ahead of everyone
# else's, so my own work is unblocked first. Once per PR, like the others: a state.json entry means it ran.
# Only PRs that became ready (opened ready, or out of draft) after this first ran, kept in selfcheck-since: the ones already open then
# are left alone. An approved one has nothing left to fix, so it is skipped too.
since_path = os.path.join(os.path.dirname(state_path), "selfcheck-since")
if not os.path.exists(since_path): open(since_path, "w").write(str(int(now)))
since = int(open(since_path).read().strip() or now)
OWN = """query { search(query: "is:open is:pr author:@me archived:false sort:created-asc", type: ISSUE, first: 50) { nodes { ... on PullRequest {
  number isDraft createdAt updatedAt reviewDecision headRefOid mergeable mergeStateStatus baseRefName headRefName repository { name nameWithOwner } author { login }
  commits(last: 1) { nodes { commit { committedDate statusCheckRollup { state contexts(first: 100) { nodes {
    __typename ... on CheckRun { name databaseId status conclusion detailsUrl } ... on StatusContext { state } } } } } } }
  reviewThreads(first: 100) { nodes { isResolved comments(last: 1) { nodes { createdAt author { login } } } } }
  latestReviews(first: 20) { nodes { state submittedAt } }
  reviewRequests { totalCount }
  requested: timelineItems(itemTypes: [REVIEW_REQUESTED_EVENT], last: 1) { nodes { ... on ReviewRequestedEvent { createdAt } } }
  baseChanges: timelineItems(itemTypes: [BASE_REF_CHANGED_EVENT], last: 1) { nodes { ... on BaseRefChangedEvent { previousRefName currentRefName createdAt } } }
  timelineItems(itemTypes: [READY_FOR_REVIEW_EVENT], last: 1) { nodes { ... on ReadyForReviewEvent { createdAt } } } } } } }"""
iso = lambda text: datetime.datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp()
def ready_at(pr): return iso((pr["timelineItems"]["nodes"] or [pr])[-1]["createdAt"])
# A self-checked PR I pushed to since (the head moved past the checked sha) is checked again once its last commit is 10 minutes old:
# a burst of pushes is one change. claude-fix's pushes count too, so a Fix is followed by a fresh fix list before any Nudge.
def recheck(pr):
    entry = state.get(key(pr), {})
    pushed = pr["commits"]["nodes"][0]["commit"]["committedDate"] if pr["commits"]["nodes"] else None
    return (entry.get("state") == "reviewed" and entry.get("report") and entry.get("sha") and entry["sha"] != pr["headRefOid"]
            and pushed and now - iso(pushed) >= 600)
own = subprocess.run(["gh", "api", "graphql", "-f", f"query={OWN}"], capture_output=True, text=True)
own_prs = json.loads(own.stdout)["data"]["search"]["nodes"] if own.returncode == 0 else []
# What Auto did, for the board's This week sheet (autolog.json, the last seven days): each review and fix it started and each CI rerun,
# [{at (ms), kind (review, fix, rerun), pr (owner/repo#n), text, sha (a fix's head when it started), done (a fix's outcome)}].
log_path = os.path.join(os.path.dirname(state_path), "autolog.json")
log = json.load(open(log_path)) if os.path.exists(log_path) else []
def note(pr, kind, text, **extra): log.append({"at": int(now * 1000), "kind": kind, "pr": key(pr), "text": text, **extra})
def save_log():
    if os.environ.get("DRY"): return
    # claude-fix adds its summary to the file while this tick runs: merge into a fresh read, so neither write loses the other's.
    fresh = json.load(open(log_path)) if os.path.exists(log_path) else []
    index = {(e["pr"], e["at"], e["kind"]): e for e in fresh}
    for e in log:
        if (e["pr"], e["at"], e["kind"]) in index: index[(e["pr"], e["at"], e["kind"])].update({k: v for k, v in e.items() if k not in index[(e["pr"], e["at"], e["kind"])]})
        else: fresh.append(e)
    kept = sorted((e for e in fresh if e["at"] >= (now - 7 * 86400) * 1000), key=lambda e: e["at"])[-300:]
    open(log_path + ".tmp", "w").write(json.dumps(kept)); os.replace(log_path + ".tmp", log_path)
# A fix that has finished: what it pushed, from the head it started on to the PR's head now.
heads = {key(pr): pr for pr in own_prs}
for e in log:
    pr = heads.get(e["pr"])
    # Settled 3 minutes on at the earliest: claude-fix marks itself running a few seconds after its tab opens.
    if e["kind"] != "fix" or "done" in e or not pr or now * 1000 - e["at"] < 180000 or state.get(e["pr"], {}).get("state") == "running": continue
    if pr["headRefOid"] == e["sha"]: e["done"] = "pushed nothing"; continue
    diff = subprocess.run(["gh", "api", f'repos/{pr["repository"]["nameWithOwner"]}/compare/{e["sha"]}...{pr["headRefOid"]}', "--jq",
                          '{status, subjects: [.commits[].commit.message | split("\\n")[0]]}'], capture_output=True, text=True)
    info = json.loads(diff.stdout) if diff.returncode == 0 else {"status": "", "subjects": []}
    commits = info["subjects"]
    e["done"] = ("rebased and pushed" if info["status"] == "diverged" else
                 f'pushed {len(commits)} commit{"s" * (len(commits) != 1)}: {"; ".join(commits[:3])}' if commits else "pushed")
mine = [pr for pr in own_prs if pr.get("reviewDecision") != "APPROVED" and eligible(pr) and (recheck(pr) or (ready_at(pr) >= since and not done(pr)))]
# Auto-fix: claude-fix (fixes, pushes, replies on the threads, re-requests review) on my own ready PR, in a background cmux tab, when
# its checks fail, it conflicts with its base, or a change request waits on me: an unresolved thread whose last comment is someone
# else's, or a request for changes after my last push, quiet for 15 minutes (the reviewer is done for now). Once per head commit, kept in
# autofix.json: a fix that pushes nothing is not run again, and one that pushes gets one more look at the new head.
# ponytail: at most 3 auto-fixes per PR ever, so a fix that keeps failing CI stops; delete its autofix.json key to allow more.
def last_commit(pr): return pr["commits"]["nodes"][0]["commit"] if pr["commits"]["nodes"] else {}
def asks(pr):
    me, pushed = pr["author"]["login"], iso(last_commit(pr).get("committedDate") or "1970-01-01T00:00:00Z")
    lasts = [thread["comments"]["nodes"][-1] for thread in pr["reviewThreads"]["nodes"] if not thread["isResolved"] and thread["comments"]["nodes"]]
    marks = [iso(c["createdAt"]) for c in lasts if (c["author"] or {}).get("login") != me]
    marks += [iso(r["submittedAt"]) for r in pr["latestReviews"]["nodes"] if r["state"] == "CHANGES_REQUESTED" and r["submittedAt"] and iso(r["submittedAt"]) > pushed]
    return bool(marks) and now - max(marks) >= 900
# Failing checks, once every check is done: "flaky" (with the Actions run ids to rerun) when each failed job is an infrastructure fault
# (a lost or killed runner, a timeout, a full disk, a job that never started), else "failing"; None while green or still running.
# ponytail: the first 100 checks only, and a regex over the failed jobs' annotations and last log lines; widen INFRA as new faults show.
import re
INFRA = re.compile(r"runner has received a shutdown signal|lost communication with the server|exceeded the maximum execution time|"
                   r"no space left on device|ENOSPC|The operation was canceled|The job was not started", re.I)
def checks(pr):
    rollup = last_commit(pr).get("statusCheckRollup") or {}
    if rollup.get("state") not in ("FAILURE", "ERROR"): return None, set()
    nodes = rollup["contexts"]["nodes"]
    if any(c.get("status", "COMPLETED") != "COMPLETED" or c.get("state") in ("PENDING", "EXPECTED") for c in nodes): return None, set()
    if any(c.get("state") in ("FAILURE", "ERROR") for c in nodes): return "failing", set()  # a commit status: nothing to rerun
    runs = set()
    for c in nodes:
        if c.get("conclusion") not in ("FAILURE", "TIMED_OUT", "STARTUP_FAILURE"): continue
        run = re.search(r"/actions/runs/(\d+)/job/", c.get("detailsUrl") or "")
        if not run: return "failing", set()
        # A gatekeeper check (crm's merge-gatekeeper) fails because another one did: rerun with it, never the reason.
        if c["conclusion"] == "FAILURE" and "gatekeeper" not in (c.get("name") or ""):
            nwo = pr["repository"]["nameWithOwner"]
            notes = subprocess.run(["gh", "api", f"repos/{nwo}/check-runs/{c['databaseId']}/annotations", "--jq", ".[].message"], capture_output=True, text=True).stdout
            if not INFRA.search(notes):
                log = subprocess.run(["gh", "api", f"repos/{nwo}/actions/jobs/{c['databaseId']}/logs"], capture_output=True, text=True).stdout
                if not INFRA.search("\n".join(log.splitlines()[-300:])): return "failing", set()
        runs.add(run.group(1))
    return ("flaky", runs) if runs else (None, set())
def why_fix(pr, ci):
    why = []
    if ci == "failing": why.append("failing checks")
    if pr.get("mergeable") == "CONFLICTING": why.append("conflicts")
    if asks(pr): why.append("change requests")
    return ", ".join(why)
# A flaky failure gets its failed jobs rerun instead, once per head commit (autofix.json "<key> rerun"): no tokens, and claude-fix only
# sees real failures. Failing again after the rerun, it goes to claude-fix.
# Stack follow-through: my PR retargeted onto its base's base (GitHub does that when the PR under it merges and its branch goes) still
# carries that PR's commits, which squash-merged under other shas. Rebased onto the new base without them, in a detached worktree
# (my checkouts stay as they are), and force-pushed with a lease on the head GitHub showed. Once per retarget. "conflicts" hands it
# to claude-fix; None when there is nothing to drop.
def restack(pr):
    event = (pr["baseChanges"]["nodes"] or [None])[-1]
    if not event or event["currentRefName"] != pr["baseRefName"] or event["previousRefName"] == pr["baseRefName"]: return None, None
    if event["createdAt"] in fixed.get(key(pr) + " stack", []): return None, None
    nwo, base, head = pr["repository"]["nameWithOwner"], pr["baseRefName"], pr["headRefName"]
    below = subprocess.run(["gh", "pr", "list", "-R", nwo, "--head", event["previousRefName"], "--state", "merged", "--json", "number,commits",
                            "--jq", ".[0] | {number, oids: [.commits[].oid]}"], capture_output=True, text=True)
    below = json.loads(below.stdout or "null") if below.returncode == 0 else None
    if not below: return None, None
    if os.environ.get("DRY"): return "dry run", below["number"]
    fixed.setdefault(key(pr) + " stack", []).append(event["createdAt"])
    checkout = os.path.join(os.path.expanduser(config["repos"]), pr["repository"]["name"])
    git = lambda *args, where=checkout: subprocess.run(["git", "-C", where, *args], capture_output=True, text=True)
    git("fetch", "origin", base, head)
    upstream = next((c for c in git("rev-list", f"origin/{base}..origin/{head}").stdout.split() if c in below["oids"]), None)
    if not upstream: return None, None
    tree = os.path.join(checkout, ".claude", "worktrees", f'restack-{pr["number"]}')
    git("worktree", "remove", "--force", tree)
    if git("worktree", "add", "--detach", tree, f"origin/{head}").returncode: return "conflicts", below["number"]
    done = git("rebase", "--onto", f"origin/{base}", upstream, where=tree).returncode == 0
    if done: done = git("push", f'--force-with-lease={head}:{pr["headRefOid"]}', "origin", f"HEAD:refs/heads/{head}", where=tree).returncode == 0
    else: git("rebase", "--abort", where=tree)
    git("worktree", "remove", "--force", tree)
    return ("rebased" if done else "conflicts"), below["number"]
# An approved PR of mine that fell behind its base (the repo wants it up to date): GitHub's update-branch, once per head, once its
# checks are done (an update restarts them). No tokens, nothing for me to pull: the merge commit is GitHub's.
def behind(pr):
    rollup = last_commit(pr).get("statusCheckRollup") or {}
    return (pr.get("reviewDecision") == "APPROVED" and pr.get("mergeStateStatus") == "BEHIND" and rollup.get("state") != "PENDING"
            and pr["headRefOid"] not in fixed.get(key(pr) + " update", []))
fixes, reruns, touched = [], [], False
for pr in own_prs:
    runs = fixed.get(key(pr), [])
    if not eligible(pr) or state.get(key(pr), {}).get("state") == "running": continue
    stacked, below = restack(pr)
    if stacked == "rebased":
        note(pr, "restack", f"Rebased onto {pr['baseRefName']} after #{below} merged"); touched = True; continue
    if stacked == "dry run": print(f'would restack {key(pr)} after #{below}', file=sys.stderr); continue
    if behind(pr) and not os.environ.get("DRY"):
        fixed.setdefault(key(pr) + " update", []).append(pr["headRefOid"]); touched = True
        if subprocess.run(["gh", "api", "-X", "PUT", f'repos/{pr["repository"]["nameWithOwner"]}/pulls/{pr["number"]}/update-branch',
                           "-f", f'expected_head_sha={pr["headRefOid"]}'], capture_output=True).returncode == 0:
            note(pr, "update", f"Updated from {pr['baseRefName']}"); continue
    if pr["headRefOid"] in runs or len(runs) >= 3: continue
    ci, run_ids = checks(pr)
    if ci == "flaky" and pr["headRefOid"] not in fixed.get(key(pr) + " rerun", []):
        if not os.environ.get("DRY"):
            for run in run_ids: subprocess.run(["gh", "run", "rerun", run, "--failed", "-R", pr["repository"]["nameWithOwner"]], capture_output=True)
        fixed.setdefault(key(pr) + " rerun", []).append(pr["headRefOid"])
        reruns.append(f'{pr["repository"]["name"]}#{pr["number"]}')
        note(pr, "rerun", "Reran CI's flaky jobs")
        ci = None
    why = why_fix(pr, "failing" if ci == "flaky" else ci)
    if stacked == "conflicts": why = ", ".join(filter(None, [f"stack conflicts after #{below} merged", why.replace("conflicts", "").strip(", ")]))
    if why: fixes.append((pr, why))
if reruns: print(f'reran flaky CI on {", ".join(reruns)}', file=sys.stderr)
if reruns or touched:
    if not os.environ.get("DRY"): open(fix_path + ".tmp", "w").write(json.dumps(fixed)); os.replace(fix_path + ".tmp", fix_path)
mine = [pr for pr in mine if all(pr is not other for other, _ in fixes)]  # its fix comes first; the self-check follows the fix's push
# Auto-nudge: my ready PR with nothing left on my side (checks green or none, no conflict, no open thread, no change request, no
# self-check due) whose pending reviewers have had a day since the last request, push or ready: the opener's ccnudge asks them again,
# which pings them. Weekdays 9:00-18:00 only, at most twice per PR (autofix.json "<key> nudge"); after that it is mine to chase.
def nudge_due(pr):
    entry, rollup = state.get(key(pr), {}), last_commit(pr).get("statusCheckRollup") or {}
    last = max([iso(e["createdAt"]) for e in pr["requested"]["nodes"]] + [iso(last_commit(pr).get("committedDate") or pr["createdAt"]), ready_at(pr)])
    return (pr["reviewRequests"]["totalCount"] > 0 and pr.get("reviewDecision") not in ("APPROVED", "CHANGES_REQUESTED")
            and pr.get("mergeable") != "CONFLICTING" and rollup.get("state") in (None, "SUCCESS")
            and all(t["isResolved"] for t in pr["reviewThreads"]["nodes"]) and entry.get("state") != "running"
            and not (entry.get("report") and entry.get("sha") != pr["headRefOid"])
            and now - last >= 86400 and len(fixed.get(key(pr) + " nudge", [])) < 2)
nudged = []
if clock.weekday() < 5 and 9 <= clock.hour < 18:
    for pr in own_prs:
        if not eligible(pr) or pr in mine or any(pr is other for other, _ in fixes) or not nudge_due(pr): continue
        if os.environ.get("DRY"): print(f"would nudge {key(pr)}", file=sys.stderr); continue
        out = subprocess.run([os.path.join(os.path.dirname(state_path), "bin", "claude-review-open"), f'ccnudge://{pr["repository"]["nameWithOwner"]}/{pr["number"]}'],
                             capture_output=True, text=True)
        fixed.setdefault(key(pr) + " nudge", []).append(int(now))
        if out.returncode == 0:
            nudged.append(f'{pr["repository"]["name"]}#{pr["number"]}')
            note(pr, "nudge", out.stdout.strip().capitalize() or "Nudged its reviewers")
todo = mine + todo
# Follow-ups (updated) after an hour without a push or a new request: the author is done for now.
# A re-request is the author saying it is ready: a Skim on the next tick. Pushes alone wait for an hour's quiet.
todo += [pr for pr in json.loads(os.environ["UPDATED"]) if eligible(pr) and (pr["asked"] or now * 1000 - pr["movedAt"] >= 3600 * 1000)]
todo.sort(key=lambda pr: (pr not in mine, not is_vip(pr)))  # stable: mine, then VIPs, then the rest; oldest first within each
# First reviewers: my ready PR, in a repo with config.json reviewers (repo name → logins and org/team slugs), that has nobody
# requested and no review yet gets that list, once per PR (autofix.json "<key> ask"), after its fix and self-check when one is due
# (a failed self-check waits for its retry).
requested = []
for pr in own_prs:
    who = config.get("reviewers", {}).get(pr["repository"]["name"])
    if (not who or pr["isDraft"] or not pr["repository"]["nameWithOwner"].startswith(config["org"] + "/") or pr in mine
            or pr["reviewRequests"]["totalCount"] or pr["latestReviews"]["nodes"] or key(pr) + " ask" in fixed
            or any(pr is other for other, _ in fixes) or state.get(key(pr), {}).get("state") == "running"
            or state.get(key(pr), {}).get("state") == "failed" and key(pr) + " retry" not in fixed): continue
    if os.environ.get("DRY"): print(f'would request {", ".join(who)} on {key(pr)}', file=sys.stderr); continue
    fixed[key(pr) + " ask"] = who
    if subprocess.run(["gh", "pr", "edit", str(pr["number"]), "-R", pr["repository"]["nameWithOwner"], "--add-reviewer", ",".join(who)],
                      capture_output=True).returncode == 0:
        requested.append(f'{pr["repository"]["name"]}#{pr["number"]}')
        note(pr, "request", f'Requested {", ".join(w.split("/")[-1] for w in who)}')
def save_fixed():
    if not os.environ.get("DRY"): open(fix_path + ".tmp", "w").write(json.dumps(fixed)); os.replace(fix_path + ".tmp", fix_path)
if nudged or requested: save_fixed()
if not todo and not fixes:
    save_log(); did = [*(["reran CI on " + ", ".join(reruns)] if reruns else []), *(["nudged " + ", ".join(nudged)] if nudged else []),
           *(["requested reviewers on " + ", ".join(requested)] if requested else [])]
    sys.exit(print(f'auto on ({"; ".join(did) or "nothing to review"})'))
# Smart depth: Deep (tests and mutations) where a missed bug costs most, a Skim for the rest. A PR is risky when a changed file matches
# one of these, or when it changes more than 500 lines.
import re
RISKY = [("a migration", re.compile(r"(^|/)migrations?/")),
         ("auth or security code", re.compile(r"auth|kratos|oauth|permission|security|secret|token", re.I)),
         ("feature flags", re.compile(r"featureflag/flags\.yml$"))]
def depth_of(pr):
    view = subprocess.run(["gh", "pr", "view", str(pr["number"]), "-R", pr["repository"]["nameWithOwner"], "--json", "additions,deletions,files"],
                          capture_output=True, text=True)
    if view.returncode: return "quick", ""
    info = json.loads(view.stdout)
    paths = [f["path"] for f in info.get("files", [])]
    why = [name for name, rule in RISKY if any(rule.search(path) for path in paths)]
    if info["additions"] + info["deletions"] > 500: why.append(f'{info["additions"] + info["deletions"]} lines')
    return ("full" if why else "quick"), ", ".join(why)
picked = fixes[:left]
for pr, why in picked:
    repo, n = pr["repository"]["name"], pr["number"]
    print(f'ccfix://{config["org"]}/{repo}/{n}/{settings.get("model", "opus")}/{settings.get("effort", "high")}\t{repo}#{n} Fix ({why})')
    fixed.setdefault(key(pr), []).append(pr["headRefOid"])
    note(pr, "fix", f"Fix ({why})", sha=pr["headRefOid"])
# ponytail: marked when printed, so a fix whose cmux tab failed to open waits for the next push.
if picked and not os.environ.get("DRY"):
    open(fix_path + ".tmp", "w").write(json.dumps(fixed)); os.replace(fix_path + ".tmp", fix_path)
for pr in todo[:None if left is None else left - len(picked)]:
    repo, n = pr["repository"]["name"], pr["number"]
    depth, why = ("quick", "") if pr.get("asked") else depth_of(pr)
    if state.get(key(pr), {}).get("state") == "failed" and state[key(pr)].get("auto"): fixed[key(pr) + " retry"] = [state[key(pr)].get("at")]
    print(f'ccreview://{config["org"]}/{repo}/{n}/{settings.get("model", "opus")}/{settings.get("effort", "high")}/{depth}\t{repo}#{n}{" Deep (" + why + ")" if why else ""}')
    note(pr, "review", ("Deep" if depth == "full" else "Skim") + (" self-check" if pr in mine else " re-review" if pr.get("asked") else " review") + (f" ({why})" if why else ""))
save_fixed()
save_log()
PY
)
  local lines=(${(f)line}) started=() failed=()
  [[ $lines[1] == cc*://* ]] || { print -r -- "${line:-auto error}"; return; }
  # Each line: the opener URL, a tab, then its label (repo#n, and why Deep when it is).
  [[ -n ${DRY:-} ]] && { print "auto on dry-run ${(j:, :)${(@)lines#*$'\t'}}"; return; }
  for line in $lines; do
    AUTO=1 FOCUS=false CMUX_QUIET=1 CMUX_SOCKET_PASSWORD=$(tr -d '[:space:]' < ~/.config/cmux/socket-password) \
      $SIDAK_DIR/bin/claude-review-open "${line%%$'\t'*}" >/dev/null 2>&1 && started+=${line#*$'\t'} || failed+=${line#*$'\t'}
    # ponytail: a pause between starts keeps their state.json writes apart; a lock in claude-review's mark() if they still collide.
    sleep 3
  done
  print "auto on started ${(j:, :)started}${failed:+ (could not open cmux for ${(j:, :)failed})}"
  (( ! $#failed ))
}

# Finished review and fix tabs (cmux workspaces "review <repo>#<n>" / "fix <repo>#<n>" whose state.json entry is not running) close
# 10 minutes after a tick first sees them idle, kept in tabs-idle.json; the tab I have selected, or pinned, stays. Every tick, Auto on or off.
tidy() {
  CMUX_QUIET=1 CMUX_SOCKET_PASSWORD=$(tr -d '[:space:]' < ~/.config/cmux/socket-password 2>/dev/null) \
    python3 - $STATE $SIDAK_DIR/tabs-idle.json $ORG <<'PY'
import json, os, re, subprocess, sys, time
state_path, idle_path, org = sys.argv[1:]
cmux = "/Applications/cmux.app/Contents/Resources/bin/cmux"
out = subprocess.run([cmux, "--json", "workspace", "list"], capture_output=True, text=True)
if out.returncode: sys.exit()
state = json.load(open(state_path))
seen = json.load(open(idle_path)) if os.path.exists(idle_path) else {}
idle, now = {}, time.time()
for ws in json.loads(out.stdout)["workspaces"]:
    title = re.fullmatch(r"(?:review|fix) (\S+)#(\d+)", ws.get("custom_title") or "")
    if not title or ws.get("selected") or ws.get("pinned") or state.get(f"{org}/{title[1]}#{title[2]}", {}).get("state") == "running": continue
    idle[ws["ref"]] = seen.get(ws["ref"], now)
    if now - idle[ws["ref"]] >= 600 and subprocess.run([cmux, "close-workspace", "--workspace", ws["ref"], "--force"], capture_output=True).returncode == 0:
        del idle[ws["ref"]]
open(idle_path + ".tmp", "w").write(json.dumps(idle)); os.replace(idle_path + ".tmp", idle_path)
PY
}

# My merged PRs (the last 14 days) leave their local branch and its worktrees behind: deleted, but only when nothing would be lost.
# The branch's tip is the merged head or behind it (nothing unpushed), every worktree on it is clean (untracked files count),
# and it is not the branch my checkout itself is on (that would mean switching it). Logged in autolog.json. DRY=1 only prints.
prune() {
  python3 - $SIDAK_DIR "$(cfg .repos)" <<'PY'
import datetime, json, os, subprocess, sys, time
sidak, repos = sys.argv[1], os.path.expanduser(sys.argv[2])
dry = bool(os.environ.get("DRY"))
since = (datetime.date.today() - datetime.timedelta(days=14)).isoformat()
QUERY = """query ($q: String!) { search(query: $q, type: ISSUE, first: 100) { nodes { ... on PullRequest {
  number headRefName headRefOid repository { nameWithOwner } } } } }"""
out = subprocess.run(["gh", "api", "graphql", "-f", f"query={QUERY}", "-f", f"q=is:pr is:merged author:@me merged:>={since}"], capture_output=True, text=True)
if out.returncode: sys.exit()
git = lambda where, *args: subprocess.run(["git", "-C", where, *args], capture_output=True, text=True)
done = []
for pr in json.loads(out.stdout)["data"]["search"]["nodes"]:
    nwo, n = pr["repository"]["nameWithOwner"], pr["number"]
    checkout = os.path.join(repos, nwo.split("/")[1])
    if not os.path.isdir(os.path.join(checkout, ".git")): continue
    branch, head = pr["headRefName"], pr["headRefOid"]
    tip = git(checkout, "rev-parse", "--verify", "-q", f"refs/heads/{branch}").stdout.strip()
    if not tip: continue
    if tip != head:
        if git(checkout, "cat-file", "-e", head).returncode: git(checkout, "fetch", "-q", "origin", f"pull/{n}/head")
        if git(checkout, "merge-base", "--is-ancestor", tip, head).returncode: continue  # local commits GitHub never saw
    git(checkout, "worktree", "prune")  # worktrees whose folder is already gone (a scratchpad's) are only listed: drop the listing
    trees, path = [], None
    for line in git(checkout, "worktree", "list", "--porcelain").stdout.splitlines():
        if line.startswith("worktree "): path = line[9:]
        elif line == f"branch refs/heads/{branch}": trees.append(path)
    if os.path.realpath(checkout) in map(os.path.realpath, trees): continue
    if any(git(tree, "status", "--porcelain").stdout.strip() for tree in trees): continue
    # A worktree touched in the last hour may still be some session's (another agent finishing up there): left for a later tick.
    index = lambda tree: os.path.join(tree, git(tree, "rev-parse", "--git-path", "index").stdout.strip())
    if any(time.time() - os.path.getmtime(index(tree)) < 3600 for tree in trees if os.path.exists(index(tree))): continue
    if dry:
        done.append(f'{nwo.split("/")[1]}#{n} {branch}{" + " + str(len(trees)) + " worktree" if trees else ""}'); continue
    if any(git(checkout, "worktree", "remove", tree).returncode for tree in trees): continue
    if git(checkout, "branch", "-D", branch).returncode: continue
    done.append(f'{nwo.split("/")[1]}#{n}')
    path_log = os.path.join(sidak, "autolog.json")
    log = json.load(open(path_log)) if os.path.exists(path_log) else []
    log.append({"at": int(time.time() * 1000), "kind": "prune", "pr": f"{nwo}#{n}",
                "text": f"Deleted its local branch{' and worktree' if len(trees) == 1 else f' and {len(trees)} worktrees' if trees else ''}"})
    open(path_log + ".tmp", "w").write(json.dumps(log)); os.replace(path_log + ".tmp", path_log)
if done: print(("would prune " if dry else "pruned ") + ", ".join(done), file=sys.stderr)
PY
}

# Morning brief, for Sidak.app's notification: once a day, on the first tick from 9:00 to 12:00 on a weekday, one line with the Inbox
# PRs to review ($INBOX, Sidak.app's count), my PRs ready to merge, and what Auto did since the last brief (autolog.json; the first
# one looks back 18 hours). brief-day keeps the last brief's time. Prints nothing the rest of the day.
brief() {
  local file=$SIDAK_DIR/brief-day now=$(date +%s) last
  (( $(date +%u) <= 5 && $(date +%k) >= 9 && $(date +%k) < 12 )) || return 0
  [[ -f $file ]] && last=$(<$file)
  [[ -n $last && $(date -r $last +%F) == $(date +%F) ]] && return 0
  # Ready as the board's Ready tab: approved, not conflicting, checks green or none. GraphQL, not gh search: its check state lags.
  local ready=$(gh api graphql -f query='{ search(query: "is:open is:pr author:@me archived:false draft:false review:approved", type: ISSUE, first: 50) {
    nodes { ... on PullRequest { mergeable commits(last: 1) { nodes { commit { statusCheckRollup { state } } } } } } } }' --jq '[.data.search.nodes[]
    | select(.mergeable != "CONFLICTING" and (.commits.nodes[0].commit.statusCheckRollup.state // "SUCCESS") == "SUCCESS")] | length' 2>/dev/null)
  local did=$(python3 - $SIDAK_DIR/autolog.json $(( last > now - 86400 ? last : now - 18 * 3600 )) <<'PY'
import collections, json, os, sys
log = json.load(open(sys.argv[1])) if os.path.exists(sys.argv[1]) else []
done = collections.Counter(e["kind"] for e in log if e["at"] >= int(sys.argv[2]) * 1000 and not e.get("manual"))
words = {"review": ("review", "reviews"), "fix": ("fix", "fixes"), "rerun": ("CI rerun", "CI reruns"), "nudge": ("nudge", "nudges"),
         "restack": ("restack", "restacks"), "request": ("reviewer request", "reviewer requests"), "update": ("branch update", "branch updates")}
print(", ".join(f"{n} {words[kind][n != 1]}" for kind, n in done.items() if kind in words))
PY
)
  print $now > $file
  print -r -- "${INBOX:-0} to review · ${ready:-0} ready to merge${did:+ · Auto did $did}"
}

status() {
  print "run: $(entry state) $(entry depth)"
  gh api repos/$ORG/$repo/pulls/$n/reviews --jq "[.[] | select(.user.login == \"$ME\")] | last
    | if . then \"my review: \(.state) \(.submitted_at)\n\(.body)\" else \"my review: none yet\" end"
  gh pr view $n -R $ORG/$repo --json reviewDecision,url --jq '"decision: \(.reviewDecision) \(.url)"'
  local handoff=$SIDAK_DIR/handoffs/$repo-$n.md
  [[ -f $handoff ]] && print "handoff: $handoff"
}

case $cmd in
  board) board ;;
  learn) learn ;;
  auto) tidy; prune; auto ;;
  quick|review) start ;;
  status) status ;;
  brief) brief ;;
  wait) while [[ $(entry state) == running ]]; do sleep 30; done; status ;;
  approve)
    gh api repos/$ORG/$repo/pulls/$n/reviews -f event=APPROVE -f body="$note" \
      -f commit_id=$(gh pr view $n -R $ORG/$repo --json headRefOid --jq .headRefOid) --jq '"approved \(.commit_id[0:10])"' ;;
  phone)
    # Personal profile: Remote Control sessions only show in the app logged into the same account.
    unset CLAUDE_CONFIG_DIR
    repos=$(cfg .repos) rules=$(cfg .rulesRepo); cd ${repos/#\~/$HOME}/${rules:-$FIRST}
    exec claude --remote-control "Sidak" --model sonnet --allowedTools "Bash($SIDAK_DIR/bin/pr-board *)" --append-system-prompt "You are the PR review board, driven from the user's phone. Every request maps to one $SIDAK_DIR/bin/pr-board command; run $SIDAK_DIR/bin/pr-board help for the list. After starting a review, run pr-board wait for it in the background and report when it settles: verdict, the blocking points in one line each. Approve only when the user says so in this conversation. Reply in short lines for a phone screen, no wide tables." ;;
  help) sed -n '3,10p' $0 ;;
  *) sed -n '3,10p' $0; exit 2 ;;
esac
