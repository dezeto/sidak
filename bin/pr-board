#!/bin/zsh
# The PR review board for the phone: the same reviews as the Arc panel, driven from a Remote Control session.
#   pr-board board                          To review / Running / Reviewed
#   pr-board auto                           one auto-review tick (Sidak.app runs it on the panel's refresh interval (settings.json pollMinutes, default 2 min)); DRY=1 prints the URL only
#   pr-board quick|review [<repo>] <pr>     start a review in cmux (repo defaults to the first reviewable one)
#   pr-board status [<repo>] <pr>           run state + my latest review on the PR
#   pr-board wait [<repo>] <pr>             block until the running review settles, then status
#   pr-board approve [<repo>] <pr> [note]   approve the PR head
#   pr-board phone                          start the Remote Control session on the personal account (the phone's)
#   MODEL=sonnet EFFORT=high ...            review overrides; default opus, medium for quick and high for review
set -u
# SIDAK_STATE / SIDAK_SETTINGS point at copies for a dry run.
SIDAK_DIR=${SIDAK_DIR:-${0:A:h:h}}
cfg() { jq -r "$@" $SIDAK_DIR/config.json; }
STATE=${SIDAK_STATE:-$SIDAK_DIR/state.json}
SETTINGS=${SIDAK_SETTINGS:-$SIDAK_DIR/settings.json}
ORG=$(cfg .org) ME=$(cfg .login) FIRST=$(cfg '.reviewable[0]')
cmd=${1:-board}; shift 2>/dev/null
if [[ ${1:-} == <-> ]]; then repo=$FIRST; else repo=${1:-$FIRST}; shift 2>/dev/null; fi
n=${1:-}; note=${2:-}
key=$ORG/$repo#$n
entry() { jq -r --arg k "$key" ".[\$k].$1 // \"\"" $STATE; }

# Reviewed PRs that moved since my review (pr.js followUp) as a JSON array, each with movedAt in ms: my latest request after the
# review, else the last commit when the head moved past the reviewed sha (no sha: a commit dated after the review) and the review
# was not an approval. [] when GitHub does not answer.
updated() {
  python3 - $STATE <<'PY'
import datetime, json, subprocess, sys
state = json.load(open(sys.argv[1]))
QUERY = """query ($q: String!) { viewer { login } search(query: $q, type: ISSUE, first: 50) { nodes { ... on PullRequest {
  number title isDraft updatedAt headRefOid repository { name nameWithOwner } author { login } commits(last: 1) { nodes { commit { committedDate } } }
  timelineItems(itemTypes: [REVIEW_REQUESTED_EVENT], last: 10) { nodes { ... on ReviewRequestedEvent { createdAt requestedReviewer { ... on User { login } } } } } } } } }"""
out = subprocess.run(["gh", "api", "graphql", "-f", f"query={QUERY}", "-f", "q=is:open is:pr archived:false reviewed-by:@me -author:@me sort:created-asc"],
                     capture_output=True, text=True)
if out.returncode: sys.exit(print("[]"))
found = json.loads(out.stdout)["data"]
def ms(iso): return datetime.datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp() * 1000
def moved_at(pr):
    entry = state.get(f'{pr["repository"]["nameWithOwner"]}#{pr["number"]}', {})
    if entry.get("state") != "reviewed": return None
    asked = [e["createdAt"] for e in pr["timelineItems"]["nodes"] if (e.get("requestedReviewer") or {}).get("login") == found["viewer"]["login"]]
    if asked and ms(asked[-1]) > entry["at"]: return ms(asked[-1])
    pushed = ms(pr["commits"]["nodes"][0]["commit"]["committedDate"]) if pr["commits"]["nodes"] else 0
    moved = pr["headRefOid"] != entry["sha"] if entry.get("sha") else pushed > entry["at"]
    return pushed if moved and entry.get("verdict") != "approved" else None
print(json.dumps([{**pr, "movedAt": at} for pr in found["search"]["nodes"] if (at := moved_at(pr)) is not None]))
PY
}

# Reviews that ended without cleaning up after themselves (the tab closed before the trap ran, or the script died): a claude-review
# or claude-fix whose process is gone leaves its worktree and a "running" entry. Removes such a worktree, settles the entry (reviewed
# when its handoff or fix list was written during the run, else failed) and stops a watcher left behind (reparented to launchd).
sweep() {
  python3 - $STATE $SIDAK_DIR "$(cfg .repos)" <<'PY'
import glob, json, os, re, signal, subprocess, sys, time
state_path, sidak, repos = sys.argv[1], sys.argv[2], os.path.expanduser(sys.argv[3])
alive = set()
for line in subprocess.run(["ps", "-axo", "pid=,ppid=,command="], capture_output=True, text=True).stdout.splitlines():
    pid, ppid, command = line.split(None, 2)
    run = re.search(r"bin/claude-(?:review|fix) (\S+) (\d+)$", command)
    if not run: continue
    if ppid == "1": os.kill(int(pid), signal.SIGKILL)
    else: alive.add((run[1], run[2]))
for wt in glob.glob(f"{repos}/*/.claude/worktrees/review-*"):
    repo, n = wt.split("/")[-4], wt.rsplit("-", 1)[1]
    if (repo, n) in alive: continue
    checkout = wt.rsplit("/.claude/", 1)[0]
    if subprocess.run(["git", "-C", checkout, "worktree", "remove", "--force", wt], capture_output=True).returncode:
        subprocess.run(["rm", "-rf", "--", wt])
state = json.load(open(state_path))
changed = False
for key, entry in state.items():
    repo, n = key.split("/", 1)[1].split("#")
    # A minute's grace: a run marks itself running before its process shows up in ps.
    if entry.get("state") != "running" or (repo, n) in alive or time.time() * 1000 - entry["at"] < 60000: continue
    if entry.get("depth") == "fix":
        state[key] = entry.get("prev") or None
        changed = True
        continue
    notes = [f for f in (f"{sidak}/reviews/{repo}-{n}.md", f"{sidak}/handoffs/{repo}-{n}.md") if os.path.exists(f) and os.path.getmtime(f) > entry.get("run", 0)]
    entry.update(state="reviewed" if notes else "failed", at=int(time.time() * 1000))
    if notes and "/reviews/" in notes[0]: entry["report"] = notes[0]
    changed = True
if changed: json.dump({key: entry for key, entry in state.items() if entry}, open(state_path, "w"))
PY
}

# Learning from my hand on Claude's reviews: a comment I deleted is a point not to make, one I reworded shows how to say it. And
# from the author's: a thread they replied to that was resolved with the code unchanged is a point this team does not want.
# Each review Claude posted gets its inline comments saved (learn/posted.json) on the first board after it lands; for a week after,
# at most hourly, they are compared with GitHub and every deletion or edit is appended to learn/lessons.jsonl, which claude-review
# hands to the next review. Runs in the background of board, so the menu bar count never waits on it.
learn() {
  python3 - $STATE $SIDAK_DIR/learn "$ME" <<'PY'
import calendar, json, os, subprocess, sys, time
state_path, folder, me = sys.argv[1:]
os.makedirs(folder, exist_ok=True)
posted_path, lessons_path = f"{folder}/posted.json", f"{folder}/lessons.jsonl"
posted = json.load(open(posted_path)) if os.path.exists(posted_path) else {}
state = json.load(open(state_path))
now = time.time()
def gh(path):
    out = subprocess.run(["gh", "api", f"{path}?per_page=100"], capture_output=True, text=True)
    return json.loads(out.stdout) if out.returncode == 0 else None
# Save each new review's comments as posted. Own PRs' self-checks post nothing; a review older than two days is left alone.
for key, entry in state.items():
    if entry.get("state") != "reviewed" or entry.get("report") or now - entry.get("run", 0) > 2 * 86400: continue
    if posted.get(key, {}).get("run") == entry.get("run"): continue
    repo, n = key.split("#")
    reviews = gh(f"repos/{repo}/pulls/{n}/reviews")
    if reviews is None: continue
    mine = [r for r in reviews if r["user"]["login"] == me and r.get("submitted_at") and
            calendar.timegm(time.strptime(r["submitted_at"], "%Y-%m-%dT%H:%M:%SZ")) >= entry["run"] - 60]
    if not mine: continue
    review = mine[-1]
    comments = gh(f"repos/{repo}/pulls/{n}/reviews/{review['id']}/comments") or []
    posted[key] = {"run": entry["run"], "review": review["id"], "checked": now, "since": now,
                   "comments": [{"id": c["id"], "path": c["path"], "line": c.get("line") or c.get("original_line"), "body": c["body"]} for c in comments]}
# Compare: a comment gone was deleted; one with another body was rewritten; one whose thread the author answered and that was resolved
# while its line stayed as it was (not outdated) was pushed back. A resolved thread whose line changed was taken: it just leaves. Each
# counts once, then leaves the snapshot.
THREADS = """query ($owner: String!, $name: String!, $n: Int!) { repository(owner: $owner, name: $name) { pullRequest(number: $n) {
  author { login } reviewThreads(first: 100) { nodes { isResolved isOutdated comments(first: 30) { nodes { databaseId author { login } body } } } } } } }"""
def threads(repo, n):
    owner, name = repo.split("/")
    out = subprocess.run(["gh", "api", "graphql", "-f", f"query={THREADS}", "-f", f"owner={owner}", "-f", f"name={name}", "-F", f"n={n}"],
                         capture_output=True, text=True)
    if out.returncode: return None, {}
    pr = json.loads(out.stdout)["data"]["repository"]["pullRequest"]
    return (pr["author"] or {}).get("login"), {t["comments"]["nodes"][0]["databaseId"]: t for t in pr["reviewThreads"]["nodes"] if t["comments"]["nodes"]}
lessons = []
for key, snap in list(posted.items()):
    if now - snap["since"] > 7 * 86400: del posted[key]; continue
    if now - snap["checked"] < 3600 or not snap["comments"]: continue
    repo, n = key.split("#")
    current = gh(f"repos/{repo}/pulls/{n}/comments")
    if current is None: continue
    snap["checked"] = now
    by_id = {c["id"]: c["body"] for c in current}
    author, thread_of = threads(repo, n)
    keep = []
    for c in snap["comments"]:
        thread = thread_of.get(c["id"])
        replies = [r["body"] for r in (thread or {}).get("comments", {}).get("nodes", [])[1:] if (r["author"] or {}).get("login") == author]
        if c["id"] not in by_id:
            lessons.append({"at": int(now), "pr": key, "path": c["path"], "kind": "deleted", "before": c["body"]})
        elif by_id[c["id"]].strip() != c["body"].strip():
            lessons.append({"at": int(now), "pr": key, "path": c["path"], "kind": "edited", "before": c["body"], "after": by_id[c["id"]]})
        elif thread and thread["isResolved"] and not thread["isOutdated"] and replies:
            lessons.append({"at": int(now), "pr": key, "path": c["path"], "kind": "pushback", "before": c["body"], "reply": replies[-1]})
        elif not (thread and thread["isResolved"]): keep.append(c)
    snap["comments"] = keep
with open(lessons_path, "a") as f:
    for lesson in lessons: f.write(json.dumps(lesson) + "\n")
tmp = posted_path + ".tmp"; json.dump(posted, open(tmp, "w")); os.replace(tmp, posted_path)
PY
}

board() {
  # Self-check fix lists (claude-review on my own PR) last a week.
  rm -f -- $SIDAK_DIR/reviews/*.md(N.mh+168)
  sweep
  learn >/dev/null 2>&1 &!
  local s=$(<$STATE) moved=$(updated)
  # The panel's stale cut-off (settings.json staleDays, default 30, 0 = off) keeps the menu bar count in step with its Inbox.
  local days=$(python3 -c 'import json, sys; print(int(json.load(open(sys.argv[1])).get("staleDays", 30)))' $SETTINGS 2>/dev/null || print 30)
  # Filtered here, not with --updated, so VIP authors (settings.json vip, logins only) still count when stale, as in the panel.
  local cutoff=$(( days > 0 ? ($(date +%s) - days * 86400) * 1000 : 0 ))
  local vip=$(jq -c '.vip // []' $SETTINGS 2>/dev/null || print '[]')
  # Snoozed PRs (settings.json snooze, h in the panel) stay out of the count until their time.
  local snooze=$(jq -c --argjson now $(( $(date +%s) * 1000 )) '(.snooze // {}) | with_entries(select(.value > $now))' $SETTINGS 2>/dev/null || print '{}')
  print "To review"
  gh search prs --review-requested=@me --state=open --archived=false --json repository,number,title,author,updatedAt --limit 50 |
    jq -r --argjson s "$s" --argjson z "$snooze" --argjson cutoff $cutoff --argjson vip "$vip" '.[] | (.repository.nameWithOwner + "#" + (.number | tostring)) as $k | ($s[$k].state // "") as $st
      | select($st != "running" and $st != "reviewed" and ($z[$k] | not))
      | select((.updatedAt | sub("\\.[0-9]+"; "") | fromdateiso8601 * 1000) > $cutoff or ([.author.login] | inside($vip)))
      | "  \(.repository.name)#\(.number) \(.title) (\(.author.login))\(if $st == "failed" then " [failed]" else "" end)"'
  # Reviewed PRs that moved since my review are to review again, as in the panel's Inbox.
  jq -r --argjson z "$snooze" '.[] | select($z[.repository.nameWithOwner + "#" + (.number | tostring)] | not)
    | "  \(.repository.name)#\(.number) \(.title) (\(.author.login)) [updated]"' <<< $moved
  print "Running"
  jq -r --arg org "$ORG/" 'to_entries[] | select(.value.state == "running") | "  \(.key | ltrimstr($org)) [\(.value.depth // "full")]"' $STATE
  print "Reviewed"
  gh search prs --reviewed-by=@me --state=open --archived=false --json repository,number,title --limit 50 |
    jq -r --argjson s "$s" --argjson m "$moved" '[$m[] | .repository.nameWithOwner + "#" + (.number | tostring)] as $moved
      | .[] | (.repository.nameWithOwner + "#" + (.number | tostring)) as $k | $s[$k] as $e | select($e.state == "reviewed" and ($moved | index($k)) == null)
      | "  \(.repository.name)#\(.number) \(.title) [\($e.depth // "full")]"'
}

# The opener runs outside the Arc host here, so it needs the cmux socket password itself.
start() {
  local before=$(entry at)
  local depth=full effort=${EFFORT:-high}
  [[ $cmd == quick ]] && { depth=quick; effort=${EFFORT:-medium}; }
  CMUX_QUIET=1 CMUX_SOCKET_PASSWORD=$(tr -d '[:space:]' < ~/.config/cmux/socket-password) \
    $SIDAK_DIR/bin/claude-review-open "ccreview://$ORG/$repo/$n/${MODEL:-opus}/$effort/$depth" >/dev/null || { print "could not open cmux"; return 1; }
  # Started once the script has marked a new run; it needs a few seconds to boot.
  repeat 15; do
    [[ $(entry state) == running && $(entry at) != $before ]] && { print "started $repo#$n ($depth, ${MODEL:-opus}/$effort)"; return; }
    sleep 2
  done
  print "the review of $repo#$n did not start; check the cmux workspace"; return 1
}

# While settings.json auto.on, start a quick review of every Inbox PR in cmux workspaces that do not take focus, with the panel's
# model and effort (Deep instead of a quick review for a risky PR: see depth_of): my own ready PRs first (a self-check), then VIPs, then the oldest request; at most settings.json autoCap auto runs a day (0, the default: no limit). A PR with a state.json entry is never started
# again, unless it is a manual run that failed, or a follow-up (updated): one I reviewed whose author pushed or re-requested me since,
# re-reviewed once it has been quiet for an hour. The one output line starts with "auto on" while the mode is on.
auto() {
  local line=$(UPDATED=$(updated) python3 - $SETTINGS $STATE $SIDAK_DIR/config.json <<'PY'
import datetime, json, os, subprocess, sys, time
settings_path, state_path, config_path = sys.argv[1:]
settings, config = json.load(open(settings_path)), json.load(open(config_path))
if not settings.get("auto", {}).get("on"): sys.exit(print("auto off"))
if subprocess.run(["pgrep", "-x", "cmux"], capture_output=True).returncode: sys.exit(print("auto on (no cmux)"))
state = json.load(open(state_path))
now = time.time()
midnight = datetime.datetime.combine(datetime.date.today(), datetime.time()).timestamp()
cap = int(settings.get("autoCap", 0))
left = cap - sum(e.get("auto", False) and e.get("run", 0) >= midnight for e in state.values()) if cap else None
if left is not None and left <= 0: sys.exit(print("auto on (cap)"))
# The Inbox's rules: reviewable from config.json, stale and VIP like pr.js (a VIP is never stale). VIP by login only: the search has no commit email.
reviewable = config["reviewable"]
vip = {entry.lower() for entry in settings.get("vip", [])}
days = int(settings.get("staleDays", 30))
search = subprocess.run(["gh", "search", "prs", "--review-requested=@me", "--state=open", "--archived=false", "--sort", "created", "--order", "asc",
                         "--limit", "50", "--json", "repository,number,isDraft,author,updatedAt"], capture_output=True, text=True)
if search.returncode: sys.exit(print("auto on (gh failed)"))
def is_vip(pr): return (pr["author"] or {}).get("login", "").lower() in vip
def stale(pr): return days > 0 and not is_vip(pr) and now - datetime.datetime.fromisoformat(pr["updatedAt"].replace("Z", "+00:00")).timestamp() > days * 86400
snooze = settings.get("snooze", {})
def key(pr): return f'{pr["repository"]["nameWithOwner"]}#{pr["number"]}'
def done(pr):
    entry = state.get(key(pr))
    return entry is not None and not (entry.get("state") == "failed" and not entry.get("auto"))
# claude-review without a checkout exits before marking, so such a PR would reopen every tick.
def checked_out(repo): return os.path.isdir(os.path.join(os.path.expanduser(config["repos"]), repo, ".git"))
# Snoozed in the panel (h): not today.
def eligible(pr): return (pr["repository"]["nameWithOwner"].startswith(config["org"] + "/") and pr["repository"]["name"] in reviewable
                          and not pr["isDraft"] and not stale(pr) and snooze.get(key(pr), 0) <= now * 1000 and checked_out(pr["repository"]["name"]))
todo = [pr for pr in json.loads(search.stdout) if eligible(pr) and not done(pr)]
# My own PRs once they are ready (out of draft): a self-check each (claude-review writes a fix list, posts nothing), ahead of everyone
# else's, so my own work is unblocked first. Once per PR, like the others: a state.json entry means it ran.
# Only PRs that became ready (opened ready, or out of draft) after this first ran, kept in selfcheck-since: the ones already open then
# are left alone. An approved one has nothing left to fix, so it is skipped too.
since_path = os.path.join(os.path.dirname(state_path), "selfcheck-since")
if not os.path.exists(since_path): open(since_path, "w").write(str(int(now)))
since = int(open(since_path).read().strip() or now)
OWN = """query { search(query: "is:open is:pr author:@me archived:false sort:created-asc", type: ISSUE, first: 50) { nodes { ... on PullRequest {
  number isDraft createdAt updatedAt reviewDecision headRefOid repository { name nameWithOwner } author { login }
  commits(last: 1) { nodes { commit { committedDate } } }
  timelineItems(itemTypes: [READY_FOR_REVIEW_EVENT], last: 1) { nodes { ... on ReadyForReviewEvent { createdAt } } } } } } }"""
iso = lambda text: datetime.datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp()
def ready_at(pr): return iso((pr["timelineItems"]["nodes"] or [pr])[-1]["createdAt"])
# A self-checked PR I pushed to since (the head moved past the checked sha) is checked again once its last commit is 10 minutes old:
# a burst of pushes is one change. claude-fix's pushes count too, so a Fix is followed by a fresh fix list before any Nudge.
def recheck(pr):
    entry = state.get(key(pr), {})
    pushed = pr["commits"]["nodes"][0]["commit"]["committedDate"] if pr["commits"]["nodes"] else None
    return (entry.get("state") == "reviewed" and entry.get("report") and entry.get("sha") and entry["sha"] != pr["headRefOid"]
            and pushed and now - iso(pushed) >= 600)
own = subprocess.run(["gh", "api", "graphql", "-f", f"query={OWN}"], capture_output=True, text=True)
mine = [pr for pr in json.loads(own.stdout)["data"]["search"]["nodes"]
        if pr.get("reviewDecision") != "APPROVED" and eligible(pr) and (recheck(pr) or (ready_at(pr) >= since and not done(pr)))] if own.returncode == 0 else []
todo = mine + todo
# Follow-ups (updated) after an hour without a push or a new request: the author is done for now.
todo += [pr for pr in json.loads(os.environ["UPDATED"]) if eligible(pr) and now * 1000 - pr["movedAt"] >= 3600 * 1000]
todo.sort(key=lambda pr: (pr not in mine, not is_vip(pr)))  # stable: mine, then VIPs, then the rest; oldest first within each
if not todo: sys.exit(print("auto on (nothing to review)"))
# Smart depth: Deep (tests and mutations) where a missed bug costs most, a Skim for the rest. A PR is risky when a changed file matches
# one of these, or when it changes more than 500 lines.
import re
RISKY = [("a migration", re.compile(r"(^|/)migrations?/")),
         ("auth or security code", re.compile(r"auth|kratos|oauth|permission|security|secret|token", re.I)),
         ("feature flags", re.compile(r"featureflag/flags\.yml$"))]
def depth_of(pr):
    view = subprocess.run(["gh", "pr", "view", str(pr["number"]), "-R", pr["repository"]["nameWithOwner"], "--json", "additions,deletions,files"],
                          capture_output=True, text=True)
    if view.returncode: return "quick", ""
    info = json.loads(view.stdout)
    paths = [f["path"] for f in info.get("files", [])]
    why = [name for name, rule in RISKY if any(rule.search(path) for path in paths)]
    if info["additions"] + info["deletions"] > 500: why.append(f'{info["additions"] + info["deletions"]} lines')
    return ("full" if why else "quick"), ", ".join(why)
for pr in todo[:left]:
    repo, n = pr["repository"]["name"], pr["number"]
    depth, why = depth_of(pr)
    print(f'ccreview://{config["org"]}/{repo}/{n}/{settings.get("model", "opus")}/{settings.get("effort", "high")}/{depth}\t{repo}#{n}{" Deep (" + why + ")" if why else ""}')
PY
)
  local lines=(${(f)line}) started=() failed=()
  [[ $lines[1] == ccreview://* ]] || { print -r -- "${line:-auto error}"; return; }
  # Each line: the opener URL, a tab, then its label (repo#n, and why Deep when it is).
  [[ -n ${DRY:-} ]] && { print "auto on dry-run ${(j:, :)${(@)lines#*$'\t'}}"; return; }
  for line in $lines; do
    AUTO=1 FOCUS=false CMUX_QUIET=1 CMUX_SOCKET_PASSWORD=$(tr -d '[:space:]' < ~/.config/cmux/socket-password) \
      $SIDAK_DIR/bin/claude-review-open "${line%%$'\t'*}" >/dev/null 2>&1 && started+=${line#*$'\t'} || failed+=${line#*$'\t'}
    # ponytail: a pause between starts keeps their state.json writes apart; a lock in claude-review's mark() if they still collide.
    sleep 3
  done
  print "auto on started ${(j:, :)started}${failed:+ (could not open cmux for ${(j:, :)failed})}"
  (( ! $#failed ))
}

status() {
  print "run: $(entry state) $(entry depth)"
  gh api repos/$ORG/$repo/pulls/$n/reviews --jq "[.[] | select(.user.login == \"$ME\")] | last
    | if . then \"my review: \(.state) \(.submitted_at)\n\(.body)\" else \"my review: none yet\" end"
  gh pr view $n -R $ORG/$repo --json reviewDecision,url --jq '"decision: \(.reviewDecision) \(.url)"'
  local handoff=$SIDAK_DIR/handoffs/$repo-$n.md
  [[ -f $handoff ]] && print "handoff: $handoff"
}

case $cmd in
  board) board ;;
  learn) learn ;;
  auto) auto ;;
  quick|review) start ;;
  status) status ;;
  wait) while [[ $(entry state) == running ]]; do sleep 30; done; status ;;
  approve)
    gh api repos/$ORG/$repo/pulls/$n/reviews -f event=APPROVE -f body="$note" \
      -f commit_id=$(gh pr view $n -R $ORG/$repo --json headRefOid --jq .headRefOid) --jq '"approved \(.commit_id[0:10])"' ;;
  phone)
    # Personal profile: Remote Control sessions only show in the app logged into the same account.
    unset CLAUDE_CONFIG_DIR
    repos=$(cfg .repos) rules=$(cfg .rulesRepo); cd ${repos/#\~/$HOME}/${rules:-$FIRST}
    exec claude --remote-control "Sidak" --model sonnet --allowedTools "Bash($SIDAK_DIR/bin/pr-board *)" --append-system-prompt "You are the PR review board, driven from the user's phone. Every request maps to one $SIDAK_DIR/bin/pr-board command; run $SIDAK_DIR/bin/pr-board help for the list. After starting a review, run pr-board wait for it in the background and report when it settles: verdict, the blocking points in one line each. Approve only when the user says so in this conversation. Reply in short lines for a phone screen, no wide tables." ;;
  help) sed -n '3,10p' $0 ;;
  *) sed -n '3,10p' $0; exit 2 ;;
esac
